{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    // ES2024 for Map.groupBy, which workerd has and @signalbox/automations uses.
    "lib": ["ES2024", "WebWorker"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src/**/*.ts", "evlog.config.ts"],
  // Bundled upstream source keeps its compiler assumptions; our adapter has a narrow typed contract.
  "exclude": ["src/isolate/node/vm/vendor"]
}
