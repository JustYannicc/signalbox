{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    // ES2024 for Map.groupBy, which workerd has and @signalbox/automations uses.
    "lib": ["ES2024", "WebWorker"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src/**/*.ts", "evlog.config.ts"],
  // Catalog composes the native shard and scheduler directly; the generated standalone Worker is unused.
  "exclude": ["src/catalog/lunora/_generated/app.ts"]
}
