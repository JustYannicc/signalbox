diff --git a/libc-bottom-half/cloudlibc/src/libc/unistd/read.c b/libc-bottom-half/cloudlibc/src/libc/unistd/read.c
index 003af48..6d3feea 100644
--- a/libc-bottom-half/cloudlibc/src/libc/unistd/read.c
+++ b/libc-bottom-half/cloudlibc/src/libc/unistd/read.c
@@ -17,27 +17,25 @@ ssize_t read(int fildes, void *buf, size_t nbyte) {
     return -1;
   }
 
-  __wasi_fdstat_t stat;
-  __wasi_errno_t stat_error = __wasi_fd_fdstat_get(fildes, &stat);
-  if (stat_error == 0 &&
-      (stat.fs_filetype == __WASI_FILETYPE_SOCKET_DGRAM ||
-       stat.fs_filetype == __WASI_FILETYPE_SOCKET_STREAM)) {
-    uint32_t socket_bytes_read;
-    uint32_t socket_error = __host_net_read_recv((uint32_t)fildes,
-        (uint8_t *)buf, (uint32_t)nbyte, 0, &socket_bytes_read);
-    if (socket_error == 0) return (ssize_t)socket_bytes_read;
-    if (socket_error != EBADF && socket_error != ENOTSOCK) {
-      errno = (int)socket_error;
-      return -1;
-    }
-  }
-
   __wasi_iovec_t iov = {.buf = buf, .buf_len = nbyte};
   size_t bytes_read;
   __wasi_errno_t error = __wasi_fd_read(fildes, &iov, 1, &bytes_read);
-  if (error != 0) {
-    errno = error == ENOTCAPABLE ? EBADF : error;
-    return -1;
+  if (error == 0) return bytes_read;
+  if (error == EBADF || error == ENOTCAPABLE) {
+    __wasi_fdstat_t stat;
+    if (__wasi_fd_fdstat_get(fildes, &stat) == 0 &&
+        (stat.fs_filetype == __WASI_FILETYPE_SOCKET_DGRAM ||
+         stat.fs_filetype == __WASI_FILETYPE_SOCKET_STREAM)) {
+      uint32_t socket_bytes_read;
+      uint32_t socket_error = __host_net_read_recv((uint32_t)fildes,
+          (uint8_t *)buf, (uint32_t)nbyte, 0, &socket_bytes_read);
+      if (socket_error == 0) return (ssize_t)socket_bytes_read;
+      if (socket_error != EBADF && socket_error != ENOTSOCK) {
+        errno = (int)socket_error;
+        return -1;
+      }
+    }
   }
-  return bytes_read;
+  errno = error == ENOTCAPABLE ? EBADF : error;
+  return -1;
 }
diff --git a/libc-bottom-half/cloudlibc/src/libc/unistd/write.c b/libc-bottom-half/cloudlibc/src/libc/unistd/write.c
index ba7138f..ec268ca 100644
--- a/libc-bottom-half/cloudlibc/src/libc/unistd/write.c
+++ b/libc-bottom-half/cloudlibc/src/libc/unistd/write.c
@@ -17,28 +17,26 @@ ssize_t write(int fildes, const void *buf, size_t nbyte) {
     return -1;
   }
 
-  __wasi_fdstat_t stat;
-  __wasi_errno_t stat_error = __wasi_fd_fdstat_get(fildes, &stat);
-  if (stat_error == 0 &&
-      (stat.fs_filetype == __WASI_FILETYPE_SOCKET_DGRAM ||
-       stat.fs_filetype == __WASI_FILETYPE_SOCKET_STREAM)) {
-    uint32_t socket_bytes_written;
-    uint32_t socket_error = __host_net_write_send((uint32_t)fildes,
-        (const uint8_t *)buf, (uint32_t)nbyte, 0, &socket_bytes_written);
-    if (socket_error == 0) return (ssize_t)socket_bytes_written;
-    if (socket_error != EBADF && socket_error != ENOTSOCK) {
-      errno = (int)socket_error;
-      return -1;
-    }
-  }
-
   __wasi_ciovec_t iov = {.buf = buf, .buf_len = nbyte};
   size_t bytes_written;
   __wasi_errno_t error =
       __wasi_fd_write(fildes, &iov, 1, &bytes_written);
-  if (error != 0) {
-    errno = error == ENOTCAPABLE ? EBADF : error;
-    return -1;
+  if (error == 0) return bytes_written;
+  if (error == EBADF || error == ENOTCAPABLE) {
+    __wasi_fdstat_t stat;
+    if (__wasi_fd_fdstat_get(fildes, &stat) == 0 &&
+        (stat.fs_filetype == __WASI_FILETYPE_SOCKET_DGRAM ||
+         stat.fs_filetype == __WASI_FILETYPE_SOCKET_STREAM)) {
+      uint32_t socket_bytes_written;
+      uint32_t socket_error = __host_net_write_send((uint32_t)fildes,
+          (const uint8_t *)buf, (uint32_t)nbyte, 0, &socket_bytes_written);
+      if (socket_error == 0) return (ssize_t)socket_bytes_written;
+      if (socket_error != EBADF && socket_error != ENOTSOCK) {
+        errno = (int)socket_error;
+        return -1;
+      }
+    }
   }
-  return bytes_written;
+  errno = error == ENOTCAPABLE ? EBADF : error;
+  return -1;
 }
