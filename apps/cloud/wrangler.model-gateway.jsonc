{
  // The ModelGateway: the only Worker that holds provider keys. Machines'
  // harnesses call it as their provider's API with per-turn model tokens,
  // which it checks with the cloud Worker over the GRANTS service binding.
  // `vp run dev:gateway` runs it locally next to `vp run dev`. See
  // docs/operations/cloud.md.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "signalbox-model-gateway",
  "main": "src/modelGateway/worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "services": [{ "binding": "GRANTS", "service": "signalbox-cloud", "entrypoint": "ModelGrants" }],
  // Secrets: ANTHROPIC_API_KEY, OPENAI_API_KEY (`.dev.vars.model-gateway` locally).
  // Optional vars: ANTHROPIC_UPSTREAM_URL, OPENAI_UPSTREAM_URL.
  "observability": { "enabled": true },
}
