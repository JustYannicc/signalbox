{
  "name": "@signalbox/cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node infra/catalogRuntime/prepare.mjs",
    "generate:catalog": "node infra/catalogRuntime/generate.ts && vp fmt src/catalog/lunora/schema.ts src/catalog/lunora/personal.ts src/catalog/lunora/personalRecovery.ts",
    "dev": "mkdir -p ../web/dist && node ../../packages/shared/src/agentProcesses/cli.ts run -- wrangler dev --env dev --port 8787 --var LOCAL_WORKERD:1 --var ENVIRONMENT_ID:cloud-dev --var 'ENVIRONMENT_LABEL:Signalbox Cloud (dev)'",
    "dev:gateway": "node ../../packages/shared/src/agentProcesses/cli.ts run -- wrangler dev -c wrangler.model-gateway.jsonc --port 8788 --inspector-port 9230",
    "typecheck": "node infra/syncProbe/prepare.mjs && node infra/catalogRuntime/prepare.mjs && node --experimental-strip-types infra/isolateProbe/prepare.ts && tsc-rs --noEmit && tsc-rs --noEmit -p tsconfig.infra.json",
    "test": "vp test run --config ../../vite.config.ts --dir ."
  },
  "dependencies": {
    "@boxd-sh/sdk": "0.2.17",
    "@cloudflare/dynamic-workflows": "0.1.1",
    "@effect/sql-sqlite-do": "catalog:",
    "@lunora/scheduler": "1.0.0-alpha.130",
    "@signalbox/account": "workspace:*",
    "@signalbox/api": "workspace:*",
    "@signalbox/automations": "workspace:*",
    "@signalbox/runner-protocol": "workspace:*",
    "@signalbox/sync": "workspace:*",
    "@t3tools/client-runtime": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/provider-core": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/source-control-core": "workspace:*",
    "@t3tools/source-control-github": "workspace:*",
    "aws4fetch": "1.0.20",
    "diff": "8.0.3",
    "effect": "catalog:",
    "evlog": "https://github.com/JustYannicc/evlog/releases/download/evlog-effect-preview.2/evlog-2.32.0-effect.2.tgz",
    "fractional-indexing": "4.0.0",
    "fzstd": "0.1.1",
    "ignore": "7.0.12",
    "jose": "catalog:",
    "lunorash": "1.0.0-alpha.398",
    "re2js": "2.8.6",
    "semver": "7.8.5",
    "slice-ansi": "9.0.1",
    "smol-toml": "1.9.0",
    "string-width": "8.2.1",
    "strip-ansi": "7.2.0",
    "tldts": "catalog:",
    "wrap-ansi": "9.0.2",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260604.1",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "@signalbox/automation-compiler": "workspace:*",
    "@types/node": "catalog:",
    "@types/semver": "7.8.0",
    "alchemy": "2.0.0-beta.80",
    "esbuild": "0.28.2",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.147.0"
  }
}
