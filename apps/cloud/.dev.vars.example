# Local secrets for `vp run dev`. Copy to .dev.vars (gitignored).
# Any random string of 32+ characters; `openssl rand -base64 32` works.
SESSION_SECRET=
# A WorkOS staging client id whose redirect URIs include http://localhost:*.
T3CODE_WORKOS_CLIENT_ID=
# Optional, but GitHub sign-ins need it to finish email verification.
T3CODE_WORKOS_API_KEY=
# Optional: Claude and Codex turns. A local Runner host (see
# docs/operations/cloud.md) and the ModelGateway that holds the provider keys.
# LOCAL_RUNNER_URL=http://127.0.0.1:8790
# MODEL_GATEWAY_URL=http://127.0.0.1:8788
# Optional: boat VMs instead of a local Runner host (docs/operations/cloud.md).
# The machines must reach CLOUD_URL and MODEL_GATEWAY_URL, e.g. through tunnels.
# MACHINE_BACKEND=boat
# BOAT_API_KEY=
# CLOUD_URL=https://<tunnel to wrangler dev>
# Optional: send cloud.* usage analytics to a PostHog project (docs/operations/cloud.md).
# SIGNALBOX_POSTHOG_KEY=
# SIGNALBOX_POSTHOG_HOST=https://us.i.posthog.com
# Optional: previews of dev servers on threads' machines, at
# http://<label>.localhost:8787 (docs/operations/cloud.md).
# PREVIEW_DOMAIN=localhost:8787
# GitHub-backed drives need nothing more: users connect GitHub through WorkOS
# Pipes with T3CODE_WORKOS_API_KEY above (docs/operations/cloud.md).
# Optional: tell chats from tasks by a thread's first message
# (docs/operations/cloud.md). Jev first when both are set, unless
# THREAD_KIND_CLASSIFIER=openai.
# TYPESAFE_API_KEY=
# OPENAI_API_KEY=
# Optional: the person's browser for real sites, on Kernel (docs/operations/cloud.md).
# Unset, a thread's machine opens them in its own headless browser.
# KERNEL_API_KEY=
