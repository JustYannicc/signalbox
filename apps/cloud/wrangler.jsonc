{
  // Signalbox Cloud for `wrangler dev`, which runs fully local (its own state
  // under .wrangler/, secrets from .dev.vars). Deploys go through the Alchemy
  // stack (alchemy.run.ts), which declares the same Durable Objects, containers
  // and buckets: change both together. See docs/operations/cloud.md.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "signalbox-cloud",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  // One origin: sign-in callbacks, cookies and saved connections all key on it.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.signalbox.run", "custom_domain": true }],
  "assets": {
    // The web app (`vp run --filter @t3tools/web build`). Same origin as the API.
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request reaches the Worker first: preview origins (`PREVIEW_DOMAIN`)
    // share these paths and must never get the app's files. The Worker hands
    // everything else to the assets binding.
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      { "name": "USERS", "class_name": "UserObject" },
      { "name": "THREADS", "class_name": "ThreadObject" },
      { "name": "POOLS", "class_name": "PoolObject" },
      { "name": "DRIVES", "class_name": "DriveObject" },
      { "name": "PREVIEW_LINKS", "class_name": "PreviewLinkRegistry" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserObject"] },
    { "tag": "v2", "new_sqlite_classes": ["ThreadObject"] },
    { "tag": "v3", "new_sqlite_classes": ["DriveObject"] },
    { "tag": "v4", "new_sqlite_classes": ["PoolObject"] },
    { "tag": "v5", "new_sqlite_classes": ["PreviewLinkRegistry"] },
  ],
  // Containers bound to Durable Objects. One entry per class: each object of
  // `class_name` gets its own container from `image`, started and stopped
  // through `ctx.container` in that object (see src/pool/PoolContainer.ts and
  // src/thread/runner/cloudflare/). `max_instances` caps how many run at once
  // across all objects of the class. Not inherited by `env`, so dev repeats it
  // (without threads, which run on the local Runner host).
  "containers": [
    {
      // A managed pool's CLIProxyAPI. Small on purpose: every pool has one.
      "class_name": "PoolObject",
      "image": "./containers/cliproxyapi/Dockerfile",
      "instance_type": "lite",
      "max_instances": 10,
      "constraints": { "jurisdiction": "eu" },
    },
    {
      // A thread's light machine (src/thread/runner/cloudflare/): the Runner
      // image built from the same commit as this Worker, so the two always
      // speak the same protocol. `vp run runner:bundle` in apps/server writes
      // the build context first.
      "class_name": "ThreadObject",
      "image": "../server/src/signalbox/runner/image/Dockerfile",
      "image_build_context": "../server/dist/runner",
      "instance_type": "basic",
      "max_instances": 50,
      "constraints": { "jurisdiction": "eu" },
    },
  ],
  // Drives' git packs (`src/drive/`). Their refs live in the DRIVES objects.
  "r2_buckets": [
    { "binding": "DRIVE_PACKS", "bucket_name": "signalbox-drives", "jurisdiction": "eu" },
    {
      // Production owns cleanup for the isolated preview bucket, never its own packs.
      "binding": "PREVIEW_DRIVE_PACKS",
      "bucket_name": "signalbox-drives-preview",
      "jurisdiction": "eu",
    },
  ],
  // Automation runs, one Workflow instance each, hosted by this Worker's
  // `AutomationWorkflow`. Each automation version loads as a Dynamic Worker
  // through `LOADER`. Not inherited by `env`, so dev repeats both.
  "workflows": [
    {
      "binding": "AUTOMATION_RUNS",
      "name": "signalbox-cloud-automations",
      "class_name": "AutomationWorkflow",
    },
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  "vars": {
    // Production identity. Never reuse it for another deployment.
    "ENVIRONMENT_ID": "4bfb70e5-7954-458a-9b75-4834c0ab4e13",
    "ENVIRONMENT_LABEL": "Signalbox Cloud",
    // Previews that may take a signed-in user's setup (`src/previewSetup/`).
    "PREVIEW_SETUP_ORIGINS": "https://preview-*.signalbox.run",
  },
  "observability": { "enabled": true },
  "env": {
    // `vp run dev`: the production Worker without its route, so `wrangler dev`
    // keeps each request's host (preview origins are `*.localhost`) instead of
    // rewriting it to the route's. Same name, so the ModelGateway's dev
    // binding still finds it.
    "dev": {
      "name": "signalbox-cloud",
      "routes": [],
      "durable_objects": {
        "bindings": [
          { "name": "USERS", "class_name": "UserObject" },
          { "name": "THREADS", "class_name": "ThreadObject" },
          { "name": "POOLS", "class_name": "PoolObject" },
          { "name": "DRIVES", "class_name": "DriveObject" },
          { "name": "PREVIEW_LINKS", "class_name": "PreviewLinkRegistry" },
        ],
      },
      // Local only: `wrangler dev` simulates the bucket under .wrangler/.
      "r2_buckets": [
        { "binding": "DRIVE_PACKS", "bucket_name": "signalbox-drives", "jurisdiction": "eu" },
        {
          "binding": "PREVIEW_DRIVE_PACKS",
          "bucket_name": "signalbox-drives-preview",
          "jurisdiction": "eu",
        },
      ],
      // Local Docker builds and runs it.
      "containers": [
        {
          "class_name": "PoolObject",
          "image": "./containers/cliproxyapi/Dockerfile",
          "instance_type": "lite",
          "max_instances": 2,
        },
      ],
      // Local only: `wrangler dev` runs the Workflow and Dynamic Workers in workerd.
      "workflows": [
        {
          "binding": "AUTOMATION_RUNS",
          "name": "signalbox-cloud-automations",
          "class_name": "AutomationWorkflow",
        },
      ],
      "worker_loaders": [{ "binding": "LOADER" }],
      // The scripted provider: a reply without a model, for trying the cloud locally.
      // The idle-chat test clock (`http/threadKindRoutes.ts`).
      "vars": { "SCRIPTED_PROVIDER": "1", "THREAD_KIND_TEST_CLOCK": "1" },
    },
  },
}
