{
  // Signalbox Cloud. `wrangler dev` runs fully local (its own state under
  // .wrangler/, secrets from .dev.vars); only `wrangler deploy` reaches
  // Cloudflare. See docs/operations/cloud.md.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "signalbox-cloud",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  // One origin: sign-in callbacks, cookies and saved connections all key on it.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.signalbox.run", "custom_domain": true }],
  "assets": {
    // The web app, built by `vp run deploy`. Same origin as the API.
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request reaches the Worker first: preview origins (`PREVIEW_DOMAIN`)
    // share these paths and must never get the app's files. The Worker hands
    // everything else to the assets binding.
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      { "name": "USERS", "class_name": "UserObject" },
      { "name": "THREADS", "class_name": "ThreadObject" },
      { "name": "DRIVES", "class_name": "DriveObject" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserObject"] },
    { "tag": "v2", "new_sqlite_classes": ["ThreadObject"] },
    { "tag": "v3", "new_sqlite_classes": ["DriveObject"] },
  ],
  // Drives' git packs (`src/drive/`). Their refs live in the DRIVES objects.
  "r2_buckets": [
    { "binding": "DRIVE_PACKS", "bucket_name": "signalbox-drives", "jurisdiction": "eu" },
  ],
  "vars": {
    // Production identity. Never reuse it for another deployment.
    "ENVIRONMENT_ID": "4bfb70e5-7954-458a-9b75-4834c0ab4e13",
    "ENVIRONMENT_LABEL": "Signalbox Cloud",
  },
  "observability": { "enabled": true },
  "env": {
    // `vp run dev`: the production Worker without its route, so `wrangler dev`
    // keeps each request's host (preview origins are `*.localhost`) instead of
    // rewriting it to the route's. Same name, so the ModelGateway's dev
    // binding still finds it.
    "dev": {
      "name": "signalbox-cloud",
      "routes": [],
      "durable_objects": {
        "bindings": [
          { "name": "USERS", "class_name": "UserObject" },
          { "name": "THREADS", "class_name": "ThreadObject" },
          { "name": "DRIVES", "class_name": "DriveObject" },
        ],
      },
      // Local only: `wrangler dev` simulates the bucket under .wrangler/.
      "r2_buckets": [
        { "binding": "DRIVE_PACKS", "bucket_name": "signalbox-drives", "jurisdiction": "eu" },
      ],
      "vars": {},
    },
    // A pull request preview: its own Worker and Durable Objects, so it never
    // shares state with production. The workflow passes the name, domain and
    // identity per pull request.
    "preview": {
      "routes": [],
      "durable_objects": {
        "bindings": [
          { "name": "USERS", "class_name": "UserObject" },
          { "name": "THREADS", "class_name": "ThreadObject" },
          { "name": "DRIVES", "class_name": "DriveObject" },
        ],
      },
      // Previews never touch production's packs.
      "r2_buckets": [
        {
          "binding": "DRIVE_PACKS",
          "bucket_name": "signalbox-drives-preview",
          "jurisdiction": "eu",
        },
      ],
      "vars": {},
    },
  },
}
