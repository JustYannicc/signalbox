+func (f codexDeviceAuthenticatorFunc) RefreshLead() *time.Duration { return nil }
+func (f codexDeviceAuthenticatorFunc) Login(ctx context.Context, cfg *config.Config, opts *sdkAuth.LoginOptions) (*coreauth.Auth, error) {
