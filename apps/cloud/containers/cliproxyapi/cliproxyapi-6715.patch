diff --git a/internal/store/acquisition_git_rollback_recovery_test.go b/internal/store/acquisition_git_rollback_recovery_test.go
new file mode 100644
index 00000000..8c49add3
--- /dev/null
+++ b/internal/store/acquisition_git_rollback_recovery_test.go
@@ -0,0 +1,133 @@
+package store
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/go-git/go-git/v6"
+	"github.com/go-git/go-git/v6/plumbing"
+	gitindex "github.com/go-git/go-git/v6/plumbing/format/index"
+	"github.com/go-git/go-git/v6/storage"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+type rollbackFailureStorer struct {
+	storage.Storer
+	phase    string
+	fault    error
+	rollback bool
+	injected bool
+}
+
+func (s *rollbackFailureStorer) SetReference(ref *plumbing.Reference) error {
+	if s.rollback && s.phase == "branch" && ref.Name().IsBranch() {
+		s.injected = true
+		return s.fault
+	}
+	return s.Storer.SetReference(ref)
+}
+
+func (s *rollbackFailureStorer) SetIndex(index *gitindex.Index) error {
+	if s.rollback && s.phase == "index" {
+		s.injected = true
+		return s.fault
+	}
+	return s.Storer.SetIndex(index)
+}
+
+func (s *rollbackFailureStorer) Close() error {
+	if closer, ok := s.Storer.(interface{ Close() error }); ok {
+		return closer.Close()
+	}
+	return nil
+}
+
+func TestGitAcquisitionRollbackFailureRetainsRecoveryJournal(t *testing.T) {
+	for _, phase := range []string{"branch", "index"} {
+		for _, existing := range []bool{false, true} {
+			name := "new"
+			if existing {
+				name = "replacement"
+			}
+			t.Run(phase+"/"+name, func(t *testing.T) {
+				root := t.TempDir()
+				remote := setupGitRemoteRepository(t, root, "master", testBranchSpec{name: "master", contents: "baseline\n"})
+				authDir := filepath.Join(root, "workspace", "auths")
+				s := NewGitTokenStore(remote, "", "", "master")
+				s.SetBaseDir(authDir)
+				if err := s.EnsureRepository(); err != nil {
+					t.Fatal(err)
+				}
+				original := []byte(`{"access_token":"original","disabled":false,"type":"codex"}`)
+				if existing {
+					if _, err := s.Save(context.Background(), &cliproxyauth.Auth{ID: "login.json", Provider: "codex", Metadata: map[string]any{"type": "codex", "access_token": "original"}}); err != nil {
+						t.Fatal(err)
+					}
+				}
+				readme := filepath.Join(root, "workspace", "README.md")
+				independent := []byte("independent edit\n")
+				if err := os.WriteFile(readme, independent, 0o600); err != nil {
+					t.Fatal(err)
+				}
+				pushErr := errors.New("push rejected")
+				rollbackErr := errors.New("rollback " + phase + " unavailable")
+				var injected *rollbackFailureStorer
+				s.openFn = func(path string) (*git.Repository, error) {
+					repo, err := git.PlainOpen(path)
+					if err != nil {
+						return nil, err
+					}
+					injected = &rollbackFailureStorer{Storer: repo.Storer, phase: phase, fault: rollbackErr}
+					repo.Storer = injected
+					return repo, nil
+				}
+				s.pushFn = func(context.Context, *git.Repository, *git.PushOptions) error {
+					injected.rollback = true
+					return pushErr
+				}
+				_, err := s.Save(cliproxyauth.WithAuthCreationIntent(context.Background()), &cliproxyauth.Auth{ID: "login.json", Provider: "codex", Metadata: map[string]any{"type": "codex", "access_token": "unpublished"}})
+				if !errors.Is(err, pushErr) || !errors.Is(err, rollbackErr) || injected == nil || !injected.injected {
+					t.Fatalf("push and rollback failures were not reached: %v", err)
+				}
+				marker := gitPublicationPath(s.repoDirSnapshot(), "auths/login.json")
+				if _, err := readGitPublication(marker, s.repoDirSnapshot(), authDir); err != nil {
+					t.Errorf("failed rollback lost its recovery journal: %v", err)
+				}
+				restarted := NewGitTokenStore(remote, "", "", "master")
+				restarted.SetBaseDir(authDir)
+				if err := restarted.EnsureRepository(); err != nil {
+					t.Fatalf("restart stayed blocked after transient rollback failure: %v", err)
+				}
+				path := filepath.Join(authDir, "login.json")
+				data, err := os.ReadFile(path)
+				if existing {
+					if err != nil || !bytes.Equal(data, original) {
+						t.Fatalf("restart changed original credentials: %q, %v", data, err)
+					}
+					assertRemoteFileContents(t, remote, "master", "auths/login.json", string(original))
+				} else if !errors.Is(err, os.ErrNotExist) {
+					t.Fatalf("restart activated an unpublished credential: %q, %v", data, err)
+				}
+				if data, err := os.ReadFile(readme); err != nil || !bytes.Equal(data, independent) {
+					t.Fatalf("restart lost unrelated work: %q, %v", data, err)
+				}
+				if _, err := os.Stat(marker); !errors.Is(err, os.ErrNotExist) {
+					t.Fatalf("successful recovery did not clear journal: %v", err)
+				}
+				if _, err := restarted.Save(context.Background(), &cliproxyauth.Auth{ID: "later.json", Provider: "codex", Metadata: map[string]any{"type": "codex", "access_token": "later"}}); err != nil {
+					t.Fatalf("recovered store cannot save: %v", err)
+				}
+				assertRemoteTreePath(t, remote, "master", "auths/later.json", true)
+				if existing {
+					assertRemoteFileContents(t, remote, "master", "auths/login.json", string(original))
+				} else {
+					assertRemoteTreePath(t, remote, "master", "auths/login.json", false)
+				}
+			})
+		}
+	}
+}
diff --git a/internal/authpublication/publication.go b/internal/authpublication/publication.go
new file mode 100644
index 00000000..001565fc
--- /dev/null
+++ b/internal/authpublication/publication.go
@@ -0,0 +1,255 @@
+// Package authpublication keeps remote commits authoritative while their local
+// credential mirror cannot be replaced.
+package authpublication
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+)
+
+const DirectoryName = ".auth-publications"
+
+var ErrPending = errors.New("credential publication awaits remote reconciliation")
+
+type record struct {
+	Name      string `json:"name"`
+	Data      []byte `json:"data"`
+	Committed bool   `json:"committed"`
+}
+
+type Pending struct {
+	path     string
+	record   record
+	previous []byte
+	finished bool
+}
+
+func markerPath(path string) string {
+	sum := sha256.Sum256([]byte(filepath.Base(path)))
+	return filepath.Join(filepath.Dir(path), DirectoryName, hex.EncodeToString(sum[:])+".json")
+}
+
+// Prepare fences readers before the remote write. A crash before confirmation
+// leaves an incomplete observation, never an activated uncommitted credential.
+func Prepare(path string, data []byte) (*Pending, error) {
+	marker := markerPath(path)
+	previous, err := os.ReadFile(marker)
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return nil, err
+	}
+	p := &Pending{path: path, record: record{Name: filepath.Base(path), Data: data}, previous: previous}
+	return p, writeRecord(marker, p.record)
+}
+
+func (p *Pending) Commit() error {
+	p.record.Committed = true
+	if err := writeRecord(markerPath(p.path), p.record); err != nil {
+		// Keep the prepared barrier if confirmation cannot be written. Runtime
+		// notification can still use the already committed in-memory credential.
+		p.finished = true
+		return err
+	}
+	p.finished = true
+	return nil
+}
+
+func (p *Pending) Abort() error {
+	if p == nil || p.finished {
+		return nil
+	}
+	p.finished = true
+	if len(p.previous) == 0 {
+		return Clear(p.path)
+	}
+	return writeBytes(markerPath(p.path), p.previous)
+}
+
+func load(path string) (record, bool, error) {
+	var r record
+	data, err := os.ReadFile(markerPath(path))
+	if errors.Is(err, os.ErrNotExist) {
+		return r, false, nil
+	}
+	if err != nil {
+		return r, true, err
+	}
+	if err := json.Unmarshal(data, &r); err != nil {
+		return r, true, err
+	}
+	if r.Name != filepath.Base(path) || len(r.Data) == 0 {
+		return r, true, fmt.Errorf("invalid credential publication record")
+	}
+	return r, true, nil
+}
+
+func HasPending(path string) bool {
+	_, exists, _ := load(path)
+	return exists
+}
+
+// ReadFile includes a confirmed remote commit even while the old JSON remains
+// readable. Unconfirmed records keep scans incomplete until backend recovery.
+func ReadFile(path string) ([]byte, error) {
+	r, exists, err := load(path)
+	if err != nil {
+		return nil, err
+	}
+	if !exists {
+		return os.ReadFile(path)
+	}
+	if !r.Committed {
+		return nil, ErrPending
+	}
+	return r.Data, nil
+}
+
+// Paths includes credentials whose first local publication failed, so directory
+// scans cannot interpret their absent mirror as a credential deletion.
+func Paths(dir string) ([]string, error) {
+	var paths []string
+	err := filepath.WalkDir(dir, func(path string, entry fs.DirEntry, errWalk error) error {
+		if errors.Is(errWalk, os.ErrNotExist) {
+			return nil
+		}
+		if errWalk != nil {
+			return errWalk
+		}
+		if !entry.IsDir() || entry.Name() != DirectoryName {
+			return nil
+		}
+		nested, errRead := pathsInDirectory(filepath.Dir(path))
+		if errRead != nil {
+			return errRead
+		}
+		paths = append(paths, nested...)
+		return filepath.SkipDir
+	})
+	return paths, err
+}
+
+func pathsInDirectory(dir string) ([]string, error) {
+	entries, err := os.ReadDir(filepath.Join(dir, DirectoryName))
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var paths []string
+	for _, entry := range entries {
+		if entry.IsDir() || filepath.Ext(entry.Name()) != ".json" {
+			continue
+		}
+		data, err := os.ReadFile(filepath.Join(dir, DirectoryName, entry.Name()))
+		if err != nil {
+			return nil, err
+		}
+		var r record
+		if err := json.Unmarshal(data, &r); err != nil {
+			return nil, err
+		}
+		if r.Name == "." || r.Name == ".." || filepath.Base(r.Name) != r.Name || len(r.Data) == 0 {
+			return nil, fmt.Errorf("invalid credential publication path")
+		}
+		path := filepath.Join(dir, r.Name)
+		if markerPath(path) != filepath.Join(dir, DirectoryName, entry.Name()) {
+			return nil, fmt.Errorf("credential publication record does not match its path")
+		}
+		paths = append(paths, path)
+	}
+	return paths, nil
+}
+
+func Clear(path string) error {
+	marker := markerPath(path)
+	err := os.Remove(marker)
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	// Remove only an empty record directory; other credentials may still own it.
+	_ = os.Remove(filepath.Dir(marker))
+	return nil
+}
+
+// Repair runs before another local save can merge or publish stale mirror data.
+func Repair(path string) error {
+	if !HasPending(path) {
+		return nil
+	}
+	data, err := ReadFile(path)
+	if err != nil {
+		return err
+	}
+	if err := writeBytes(path, data); err != nil {
+		return err
+	}
+	return Clear(path)
+}
+
+func writeRecord(path string, r record) error {
+	data, err := json.Marshal(r)
+	if err != nil {
+		return err
+	}
+	return writeBytes(path, data)
+}
+
+func writeBytes(path string, data []byte) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(filepath.Dir(path), ".publication-*")
+	if err != nil {
+		return err
+	}
+	defer func() { _ = os.Remove(file.Name()) }()
+	if _, err := file.Write(data); err != nil {
+		_ = file.Close()
+		return err
+	}
+	if err := file.Close(); err != nil {
+		return err
+	}
+	return os.Rename(file.Name(), path)
+}
+
+// ReconciledDirectory retires publication records after startup has loaded an
+// authoritative backend snapshot. Callers must exclude concurrent saves.
+func ReconciledDirectory(dir string) error {
+	return filepath.WalkDir(dir, func(path string, entry fs.DirEntry, err error) error {
+		if errors.Is(err, os.ErrNotExist) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		if entry.IsDir() && entry.Name() == DirectoryName {
+			if err := os.RemoveAll(path); err != nil {
+				return err
+			}
+			return filepath.SkipDir
+		}
+		return nil
+	})
+}
+
+func DiscardUnconfirmed(path string) error {
+	r, exists, err := load(path)
+	if err != nil || !exists || r.Committed {
+		return err
+	}
+	return Clear(path)
+}
+
+func Stat(path string) (os.FileInfo, error) {
+	if HasPending(path) {
+		return os.Stat(markerPath(path))
+	}
+	return os.Stat(path)
+}
