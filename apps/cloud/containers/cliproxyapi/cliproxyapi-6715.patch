index c7d53a3b2c6..4bbf5645e69 100644
--- a/docs/management-api-v8.md
+++ b/docs/management-api-v8.md
@@ -131,6 +131,43 @@ Keep any provider-specific login parameters in the query string. The login
 response includes the authorization URL and a session `state`. Use that state
 for status queries and cancellation.
 
+Codex keeps its browser callback flow by default. To start Codex device login,
+add `flow=device`; the response returns the verification `url`, `user_code`,
+`expires_in`, and `state` before polling begins:
+
+```sh
+start=$(curl -fsS -H "Authorization: Bearer $MANAGEMENT_KEY" \
+  "$BASE_URL/v8/management/oauth/auth-url?provider=codex&flow=device")
+printf '%s\n' "$start" | jq '{url, user_code, expires_in}'
+state=$(printf '%s\n' "$start" | jq -r '.state')
+```
+
+Open the returned URL and enter the user code. This polls the existing status
+route until it returns `ok` or `error`:
+
+```sh
+while :; do
+  status=$(curl -fsS -G -H "Authorization: Bearer $MANAGEMENT_KEY" \
+    --data-urlencode "state=$state" "$BASE_URL/v8/management/oauth/status")
+  printf '%s\n' "$status"
+  case "$(printf '%s\n' "$status" | jq -r '.status')" in
+    ok|error) break ;;
+  esac
+  sleep 1
+done
+```
+
+To cancel instead, call the existing session route:
+
+```sh
+curl -fsS -X DELETE -G -H "Authorization: Bearer $MANAGEMENT_KEY" \
+  --data-urlencode "state=$state" "$BASE_URL/v8/management/oauth/session"
+```
+
+For Codex device login, `cancelled: true` means credentials will not be saved.
+Once credential persistence has started, cancellation returns `cancelled: false`;
+continue polling the status route for the result.
+
 Callbacks accept `provider`, `state`, `code`, and `error` as GET query parameters
 or POST JSON fields. POST also accepts `redirect_url` containing the complete
 callback URL. If `provider` is omitted, it is inferred from the pending state;
diff --git a/internal/api/handlers/management/auth_files_codex_device.go b/internal/api/handlers/management/auth_files_codex_device.go
new file mode 100644
index 00000000000..48d762923fe
--- /dev/null
+++ b/internal/api/handlers/management/auth_files_codex_device.go
@@ -0,0 +1,131 @@
+package management
+
+import (
+	"context"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/misc"
+	sdkAuth "github.com/router-for-me/CLIProxyAPI/v8/sdk/auth"
+	log "github.com/sirupsen/logrus"
+)
+
+const codexDeviceStartTimeout = 30 * time.Second
+
+// RequestCodexDeviceToken starts the existing SDK device login for the v8 API.
+func (h *Handler) RequestCodexDeviceToken(c *gin.Context) {
+	state, errState := misc.GenerateRandomState()
+	if errState != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "failed to generate state parameter"})
+		return
+	}
+	RegisterOAuthSession(state, "codex")
+
+	ctx, cancel := context.WithCancel(PopulateAuthContext(context.Background(), c))
+	deviceCodeCh := make(chan sdkAuth.DeviceCodeInfo, 1)
+	loginDone := make(chan struct{})
+	go watchOAuthSessionCancel(ctx, cancel, state, "codex")
+	go func() {
+		defer close(loginDone)
+		defer cancel()
+
+		authenticator := h.codexDeviceAuthenticator
+		if authenticator == nil {
+			authenticator = sdkAuth.NewCodexAuthenticator()
+		}
+		record, errLogin := authenticator.Login(ctx, h.cfg, &sdkAuth.LoginOptions{
+			NoBrowser: true,
+			Metadata:  map[string]string{"codex_login_mode": "device"},
+			OnDeviceCode: func(info sdkAuth.DeviceCodeInfo) {
+				select {
+				case deviceCodeCh <- info:
+				case <-ctx.Done():
+				}
+			},
+		})
+		if !IsOAuthSessionPending(state, "codex") {
+			return
+		}
+		if errLogin != nil || record == nil {
+			log.Error("Codex device authentication failed")
+			SetOAuthSessionError(state, "Authentication failed")
+			return
+		}
+		if !oauthSessions.BeginSave(state, "codex") {
+			return
+		}
+		if _, errSave := h.saveTokenRecord(ctx, record); errSave != nil {
+			log.Error("Failed to save Codex device authentication")
+			SetOAuthSessionError(state, "Failed to save authentication tokens")
+			return
+		}
+		CompleteOAuthSession(state)
+	}()
+
+	startTimer := time.NewTimer(codexDeviceStartTimeout)
+	defer startTimer.Stop()
+	info, started, timedOut := waitForCodexDeviceStart(deviceCodeCh, loginDone, startTimer.C)
+	if started {
+		userCode := strings.TrimSpace(info.UserCode)
+		verificationURL := strings.TrimSpace(info.VerificationURL)
+		if userCode == "" || verificationURL == "" || info.ExpiresIn <= 0 {
+			CancelOAuthSession(state)
+			cancel()
+			c.JSON(http.StatusBadGateway, gin.H{"error": "invalid device authorization response"})
+			return
+		}
+		c.JSON(http.StatusOK, gin.H{
+			"status":     "ok",
+			"url":        verificationURL,
+			"state":      state,
+			"flow":       "device",
+			"user_code":  userCode,
+			"expires_in": info.ExpiresIn,
+		})
+		return
+	}
+	if timedOut {
+		CancelOAuthSession(state)
+		cancel()
+		c.JSON(http.StatusGatewayTimeout, gin.H{"error": "device authorization flow timed out"})
+		return
+	}
+
+	oauthSessions.Discard(state)
+	c.JSON(http.StatusBadGateway, gin.H{"error": "failed to start device authorization flow"})
+}
+
+func waitForCodexDeviceStart(deviceCodeCh <-chan sdkAuth.DeviceCodeInfo, loginDone <-chan struct{}, timeout <-chan time.Time) (sdkAuth.DeviceCodeInfo, bool, bool) {
+	if info, ok := takeReadyCodexDeviceCode(deviceCodeCh); ok {
+		return info, true, false
+	}
+	return waitForCodexDeviceStartAfterDrain(deviceCodeCh, loginDone, timeout)
+}
+
+func waitForCodexDeviceStartAfterDrain(deviceCodeCh <-chan sdkAuth.DeviceCodeInfo, loginDone <-chan struct{}, timeout <-chan time.Time) (sdkAuth.DeviceCodeInfo, bool, bool) {
+	select {
+	case info := <-deviceCodeCh:
+		return info, true, false
+	case <-loginDone:
+		if info, ok := takeReadyCodexDeviceCode(deviceCodeCh); ok {
+			return info, true, false
+		}
+		return sdkAuth.DeviceCodeInfo{}, false, false
+	case <-timeout:
+		if info, ok := takeReadyCodexDeviceCode(deviceCodeCh); ok {
+			return info, true, false
+		}
+		return sdkAuth.DeviceCodeInfo{}, false, true
+	}
+}
+
+func takeReadyCodexDeviceCode(deviceCodeCh <-chan sdkAuth.DeviceCodeInfo) (sdkAuth.DeviceCodeInfo, bool) {
+	select {
+	case info := <-deviceCodeCh:
+		return info, true
+	default:
+		return sdkAuth.DeviceCodeInfo{}, false
+	}
+}
