+package management
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httputil"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/auth/claude"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/auth/codex"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/store"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/watcher/synthesizer"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestAcquisitionRuntimeSyncUsesCommittedCredential(t *testing.T) {
+	for _, provider := range []string{"codex", "claude"} {
+		for _, existing := range []bool{false, true} {
+			name := "new"
+			if existing {
+				name = "replacement"
+			}
+			t.Run(provider+"/"+name, func(t *testing.T) {
+				root := t.TempDir()
+				authDir := filepath.Join(root, "auths")
+				var uploaded []byte
+				remote := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					if r.Method != http.MethodPut || r.URL.Path != "/credentials/auths/acquired.json" {
+						t.Errorf("unexpected object request: %s %s", r.Method, r.URL)
+						w.WriteHeader(http.StatusBadRequest)
+						return
+					}
+					data, err := io.ReadAll(r.Body)
+					if err != nil {
+						t.Error(err)
+						w.WriteHeader(http.StatusInternalServerError)
+						return
+					}
+					if strings.Contains(r.Header.Get("X-Amz-Content-Sha256"), "STREAMING") {
+						data, err = io.ReadAll(httputil.NewChunkedReader(bytes.NewReader(data)))
+						if err != nil {
+							t.Error(err)
+							w.WriteHeader(http.StatusInternalServerError)
+							return
+						}
+					}
+					uploaded = data
+					staged, err := filepath.Glob(filepath.Join(authDir, ".auth-acquisition-*", "credential"))
+					if err != nil || len(staged) != 1 {
+						t.Errorf("staged credential: %v, %v", staged, err)
+						w.WriteHeader(http.StatusInternalServerError)
+						return
+					}
+					// Lose the staged mirror after the remote received it. The final rename
