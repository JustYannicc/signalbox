@@ -0,0 +1,68 @@
+package management
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/auth/claude"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+)
+
+func TestStartOAuthV8ClaudeManualFlowUsesHostedCallbackWithoutForwarder(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	replaceOAuthSessionStoreForTest(t, newOAuthSessionStore(time.Minute))
+	h := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: t.TempDir()}, nil)
+	router := gin.New()
+	router.GET("/v8/management/oauth/auth-url", h.StartOAuthV8)
+	router.DELETE("/v8/management/oauth/session", h.CancelAuthSession)
+
+	callbackForwardersMu.Lock()
+	before := callbackForwarders[anthropicCallbackPort]
+	callbackForwardersMu.Unlock()
+	start := httptest.NewRecorder()
+	router.ServeHTTP(start, httptest.NewRequest(http.MethodGet,
+		"/v8/management/oauth/auth-url?provider=claude&flow=manual&is_webui=1", nil))
+	if start.Code != http.StatusOK {
+		t.Fatalf("start status = %d, body=%s", start.Code, start.Body.String())
+	}
+	var response struct {
+		URL   string `json:"url"`
+		State string `json:"state"`
+		Flow  string `json:"flow"`
+	}
+	if err := json.Unmarshal(start.Body.Bytes(), &response); err != nil {
+		t.Fatal(err)
+	}
+	parsed, err := url.Parse(response.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if response.Flow != "manual" || parsed.Scheme+"://"+parsed.Host+parsed.Path != claude.ManualAuthURL {
+		t.Fatalf("manual flow response = %s", start.Body.String())
+	}
+	if got := parsed.Query().Get("redirect_uri"); got != claude.ManualRedirectURI {
+		t.Fatalf("redirect_uri = %q, want %q", got, claude.ManualRedirectURI)
+	}
+	if response.State == "" {
+		t.Fatal("manual flow response has no state")
+	}
+
+	callbackForwardersMu.Lock()
+	after := callbackForwarders[anthropicCallbackPort]
+	callbackForwardersMu.Unlock()
+	if after != before {
+		t.Fatal("manual flow started or replaced the local Claude callback forwarder")
+	}
+
+	cancel := httptest.NewRecorder()
+	router.ServeHTTP(cancel, httptest.NewRequest(http.MethodDelete,
+		"/v8/management/oauth/session?state="+url.QueryEscape(response.State), nil))
+	if cancel.Code != http.StatusOK {
+		t.Fatalf("cancel status = %d, body=%s", cancel.Code, cancel.Body.String())
+	}
+}
