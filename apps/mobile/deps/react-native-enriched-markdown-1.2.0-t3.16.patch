+package com.swmansion.enriched.markdown.source
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [30])
+class SourceSelectionTest {
+  @Test
+  fun acceptsExactSourceAndWholeSupplementaryScalar() {
+    val markdown = "a😀b"
+    val selection =
+      parseSourceSelection(
+        """{"version":1,"revision":"rev-2","requestId":"find-8","sourceMarkdown":"a😀b","ranges":[{"start":1,"end":3}]}""",
+      )
+
+    assertNotNull(selection)
+    assertTrue(requireNotNull(selection).isValidFor(markdown, "rev-2"))
+    assertFalse(requireNotNull(selection).isValidFor("other", "rev-2"))
+  }
+
+  @Test
+  fun rejectsOffsetsInsideSupplementaryScalarsAndFractionalJsonNumbers() {
+    val splitScalar =
+      parseSourceSelection(
+        """{"version":1,"revision":"r","requestId":"q","sourceMarkdown":"a😀b","ranges":[{"start":2,"end":3}]}""",
+      )
+    val fractional =
+      parseSourceSelection(
+        """{"version":1,"revision":"r","requestId":"q","sourceMarkdown":"abc","ranges":[{"start":0.5,"end":1}]}""",
+      )
+
+    assertFalse(requireNotNull(splitScalar).isValidFor("a😀b", "r"))
+    assertFalse(requireNotNull(fractional).isValidFor("abc", "r"))
+  }
+
+  @Test
+  fun checksScalarBoundariesOnAnyCharSequence() {
+    val text = StringBuilder("😀")
+
+    assertTrue(isScalarBoundary(text, 0))
+    assertFalse(isScalarBoundary(text, 1))
+    assertTrue(isScalarBoundary(text, 2))
+  }
+
+  @Test
+  fun permitsLabelsOnlyButRejectsAnEmptySelection() {
+    val labelOnly =
+      parseSourceSelection(
+        """{"version":1,"revision":"r","requestId":"q","sourceMarkdown":"[title](https://x)","ranges":[],"labels":[{"kind":"link-label","sourceStart":1,"sourceEnd":6,"text":"Display title","start":0,"end":7}]}""",
+      )
+    val empty =
+      parseSourceSelection(
+        """{"version":1,"revision":"r","requestId":"q","sourceMarkdown":"abc","ranges":[]}""",
+      )
+
+    assertTrue(requireNotNull(labelOnly).isValidFor("[title](https://x)", "r"))
+    assertFalse(requireNotNull(empty).isValidFor("abc", "r"))
+  }
+
+  @Test
+  fun projectsPartialSlicesOfCompactedIdentityRuns() {
+    val projected =
+      projectSourceRange(
+        SourceRange(4, 7),
+        listOf(SourceProjectionRun(sourceStart = 2, sourceEnd = 10, displayStart = 0, displayEnd = 8)),
+      )
+
+    assertEquals(listOf(ProjectedSourceRange(4, 7, 2, 5)), projected)
+  }
+
+  @Test
+  fun deduplicatesOnePillAfterProjectingEveryOwnedSourceRun() {
+    val projections =
+      projectSourceRange(
+        SourceRange(1, 8),
+        listOf(
+          SourceProjectionRun(sourceStart = 1, sourceEnd = 2, displayStart = 0, displayEnd = 1),
+          SourceProjectionRun(sourceStart = 2, sourceEnd = 7, displayStart = 1, displayEnd = 2),
+          SourceProjectionRun(sourceStart = 7, sourceEnd = 8, displayStart = 2, displayEnd = 3),
+        ),
+      )
+    val pill = Any()
+    val visualTargets = projections!!.map { DisplayTarget(pill, start = 0, end = 3) }
+
+    assertEquals(3, projections.size)
+    assertEquals(listOf(DisplayTarget(pill, start = 0, end = 3)), deduplicateVisualTargets(visualTargets))
+    assertNull(deduplicateVisualTargets(listOf(DisplayTarget(pill, 0, 2), DisplayTarget(pill, 0, 3))))
+  }
+
+  @Test
+  fun includesAncestorTranslationInRootRelativeCoordinates() {
+    val mapped =
+      rootRelativeRect(
+        localRect = SourceRect(left = 4, top = 5, right = 14, bottom = 15),
+        viewScreenOrigin = SourcePoint(x = 130, y = 220),
+        rootScreenOrigin = SourcePoint(x = 100, y = 200),
+      )
+
+    assertEquals(SourceRect(left = 34, top = 25, right = 44, bottom = 35), mapped)
+  }
+
+  @Test
+  fun requiresFullAtomicMappingsAndRejectsSourceGaps() {
+    val atomic = listOf(SourceProjectionRun(sourceStart = 3, sourceEnd = 8, displayStart = 0, displayEnd = 1))
+    val gap =
+      listOf(
+        SourceProjectionRun(sourceStart = 0, sourceEnd = 2, displayStart = 0, displayEnd = 2),
+        SourceProjectionRun(sourceStart = 3, sourceEnd = 5, displayStart = 2, displayEnd = 4),
+      )
+
+    assertNull(projectSourceRange(SourceRange(4, 8), atomic))
+    assertEquals(listOf(ProjectedSourceRange(3, 8, 0, 1)), projectSourceRange(SourceRange(3, 8), atomic))
+    assertNull(projectSourceRange(SourceRange(0, 5), gap))
+  }
+}
