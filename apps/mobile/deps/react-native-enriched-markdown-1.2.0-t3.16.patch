+  NSInteger maximum = NSIntegerMin;
+  ENRMCollectSourceBounds(node, &minimum, &maximum);
+  if (minimum == NSIntegerMax || maximum <= minimum)
+    return NO;
+  if (start)
+    *start = minimum;
+  if (end)
+    *end = maximum;
+  return YES;
+}
