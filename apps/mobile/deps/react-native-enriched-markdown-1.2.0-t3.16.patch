+{
+  for (MarkdownSourceRun *run in node.sourceRuns) {
+    if (run.sourceStart < 0 || run.sourceEnd <= run.sourceStart)
+      continue;
+    *minimum = MIN(*minimum, run.sourceStart);
+    *maximum = MAX(*maximum, run.sourceEnd);
+  }
