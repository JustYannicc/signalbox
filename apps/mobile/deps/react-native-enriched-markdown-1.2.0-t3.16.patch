+    @{@"kind" : @"link-label",
+      @"sourceStart" : @12,
+      @"sourceEnd" : @13,
+      @"text" : @"Beta",
+      @"start" : @0,
+      @"end" : @4},
+    @{@"kind" : @"link-label",
+      @"sourceStart" : @1,
+      @"sourceEnd" : @2,
+      @"text" : @"Alpha",
+      @"start" : @0,
+      @"end" : @5}
+  ];
+  ENRMSourceSelectionRequest *request = ENRMTestSelection(@"labels", markdown, @[], labels);
+  NSArray *targets = @[ ENRMTestTarget(12, 13, 1, 1, YES, @"Beta"), ENRMTestTarget(1, 2, 0, 1, YES, @"Alpha") ];
+  NSArray<ENRMSourceSelectionTarget *> *resolved = nil;
