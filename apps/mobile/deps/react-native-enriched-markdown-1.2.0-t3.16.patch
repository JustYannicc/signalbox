+  target.sourceStart = sourceStart;
+  target.sourceEnd = sourceEnd;
+  target.renderedRange = NSMakeRange(renderStart, renderLength);
+  target.pill = pill;
+  target.pillLabel = label;
+  target.attributedText = [[NSAttributedString alloc] initWithString:@"x"];
+  target.owner = [NSObject new];
+  return target;
+}
