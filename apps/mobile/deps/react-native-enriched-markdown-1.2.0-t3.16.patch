+{
+  NSInteger lower = 0;
+  NSInteger upper = 0;
+  if (!ENRMJSONInteger(dictionary[startKey], &lower) || !ENRMJSONInteger(dictionary[endKey], &upper) ||
+      upper <= lower || (NSUInteger)upper > text.length || !ENRMIsUTF16ScalarBoundary(text, lower) ||
+      !ENRMIsUTF16ScalarBoundary(text, upper))
+    return NO;
+  if (start)
+    *start = lower;
+  if (end)
+    *end = upper;
+  return YES;
+}
+
+static NSDictionary *_Nullable ENRMJSONDictionary(NSString *json)
+{
+  if (json.length == 0)
+    return nil;
+  NSData *data = [json dataUsingEncoding:NSUTF8StringEncoding];
+  id value = data ? [NSJSONSerialization JSONObjectWithData:data options:NSJSONReadingFragmentsAllowed error:nil] : nil;
+  return [value isKindOfClass:NSDictionary.class] ? value : nil;
+}
+
+static BOOL ENRMV1Envelope(NSDictionary *payload, NSString *revision, NSString *sourceMarkdown)
+{
+  NSInteger version = 0;
+  return ENRMJSONInteger(payload[@"version"], &version) && version == 1 &&
+         [payload[@"revision"] isKindOfClass:NSString.class] && [payload[@"revision"] length] > 0 &&
+         [payload[@"revision"] isEqualToString:revision] && [payload[@"sourceMarkdown"] isKindOfClass:NSString.class] &&
+         [payload[@"sourceMarkdown"] isEqualToString:sourceMarkdown];
+}
+
+ENRMSourceSelectionRequest *_Nullable ENRMParseSourceSelection(NSString *json, NSString *sourceMarkdown)
+{
+  NSDictionary *payload = ENRMJSONDictionary(json);
+  if (!payload)
+    return nil;
+
+  if (![payload[@"revision"] isKindOfClass:NSString.class] || [payload[@"revision"] length] == 0 ||
+      ![payload[@"requestId"] isKindOfClass:NSString.class] || [payload[@"requestId"] length] == 0)
+    return nil;
+
+  NSInteger version = 0;
+  BOOL valid = ENRMJSONInteger(payload[@"version"], &version) && version == 1 &&
+               [payload[@"sourceMarkdown"] isKindOfClass:NSString.class] &&
+               [payload[@"ranges"] isKindOfClass:NSArray.class];
+
+  NSString *selectionMarkdown =
+      [payload[@"sourceMarkdown"] isKindOfClass:NSString.class] ? payload[@"sourceMarkdown"] : @"";
+  NSArray *sourceRanges = [payload[@"ranges"] isKindOfClass:NSArray.class] ? payload[@"ranges"] : @[];
+
+  NSMutableArray<NSValue *> *ranges = [NSMutableArray arrayWithCapacity:sourceRanges.count];
+  NSInteger previousEnd = -1;
+  for (id item in sourceRanges) {
+    if (![item isKindOfClass:NSDictionary.class]) {
+      valid = NO;
+      break;
+    }
+    NSInteger start = 0;
+    NSInteger end = 0;
+    if (!ENRMJSONRange(item, @"start", @"end", selectionMarkdown, &start, &end) || start < previousEnd) {
+      valid = NO;
+      break;
+    }
+    [ranges addObject:[NSValue valueWithRange:NSMakeRange((NSUInteger)start, (NSUInteger)(end - start))]];
+    previousEnd = end;
+  }
+
+  NSMutableArray<ENRMSourceSelectionDisplayLabel *> *labels = [NSMutableArray array];
+  id labelValue = payload[@"labels"];
+  if (labelValue && ![labelValue isKindOfClass:NSArray.class])
+    valid = NO;
+  NSMutableSet<NSString *> *seenAnchors = [NSMutableSet set];
+  for (id item in [labelValue isKindOfClass:NSArray.class] ? labelValue : @[]) {
+    if (![item isKindOfClass:NSDictionary.class] || ![item[@"kind"] isEqual:@"link-label"] ||
+        ![item[@"text"] isKindOfClass:NSString.class]) {
+      valid = NO;
+      break;
+    }
+    NSInteger sourceStart = 0;
+    NSInteger sourceEnd = 0;
+    NSInteger start = 0;
+    NSInteger end = 0;
+    NSString *displayText = item[@"text"];
+    if (displayText.length == 0 ||
+        !ENRMJSONRange(item, @"sourceStart", @"sourceEnd", selectionMarkdown, &sourceStart, &sourceEnd) ||
+        !ENRMJSONRange(item, @"start", @"end", displayText, &start, &end)) {
+      valid = NO;
+      break;
+    }
+    NSString *key = ENRMSourceAnchorKey(sourceStart, sourceEnd);
+    if ([seenAnchors containsObject:key]) {
+      valid = NO;
+      break;
+    }
+    [seenAnchors addObject:key];
+
+    ENRMSourceSelectionDisplayLabel *label = [[ENRMSourceSelectionDisplayLabel alloc] init];
+    label.sourceStart = sourceStart;
+    label.sourceEnd = sourceEnd;
+    label.start = start;
+    label.end = end;
+    label.text = displayText;
+    [labels addObject:label];
+  }
+
+  ENRMSourceSelectionRequest *request = [[ENRMSourceSelectionRequest alloc] init];
+  request.version = version;
+  request.revision = payload[@"revision"];
+  request.requestId = payload[@"requestId"];
+  request.sourceMarkdown = selectionMarkdown;
+  request.sourceMarkdownMatches = [request.sourceMarkdown isEqualToString:sourceMarkdown];
+  request.ranges = ranges;
+  request.labels = labels;
+  request.valid = valid && (ranges.count > 0 || labels.count > 0);
+  return request;
+}
+
+NSDictionary<NSString *, NSString *> *ENRMSourceLinkPillOverrides(NSString *json, NSString *revision,
+                                                                  NSString *sourceMarkdown)
+{
+  NSDictionary *payload = ENRMJSONDictionary(json);
+  if (!payload || revision.length == 0 || !ENRMV1Envelope(payload, revision, sourceMarkdown) ||
+      ![payload[@"labels"] isKindOfClass:NSArray.class])
+    return @{};
+
+  NSMutableDictionary<NSString *, NSString *> *overrides = [NSMutableDictionary dictionary];
+  for (id item in payload[@"labels"]) {
+    if (![item isKindOfClass:NSDictionary.class] || ![item[@"label"] isKindOfClass:NSString.class])
+      return @{};
+    NSInteger start = 0;
+    NSInteger end = 0;
+    NSString *label = item[@"label"];
+    if (label.length == 0 || !ENRMJSONRange(item, @"sourceStart", @"sourceEnd", sourceMarkdown, &start, &end))
+      return @{};
+    NSString *key = ENRMSourceAnchorKey(start, end);
+    if (overrides[key])
+      return @{};
+    overrides[key] = label;
+  }
+  return [overrides copy];
+}
+
+NSArray<ENRMSourceSelectionTarget *> *ENRMSourceSelectionTargets(NSAttributedString *text, id owner)
+{
+  if (text.length == 0)
+    return @[];
+
+  NSMutableArray<ENRMSourceSelectionTarget *> *targets = [NSMutableArray array];
+  NSRange fullRange = NSMakeRange(0, text.length);
+  [text enumerateAttribute:ENRMSourceRunAttributeName
+                   inRange:fullRange
+                   options:0
+                usingBlock:^(MarkdownSourceRun *run, NSRange range, BOOL *stop) {
+                  if (![run isKindOfClass:MarkdownSourceRun.class] || run.sourceStart < 0 ||
+                      run.sourceEnd <= run.sourceStart)
+                    return;
+                  ENRMSourceSelectionTarget *target = [[ENRMSourceSelectionTarget alloc] init];
+                  target.attributedText = text;
+                  target.owner = owner;
+                  target.renderedRange = range;
+                  target.sourceStart = run.sourceStart;
+                  target.sourceEnd = run.sourceEnd;
+                  [targets addObject:target];
+                }];
+  [text enumerateAttribute:ENRMSourceAnchorAttributeName
+                   inRange:fullRange
+                   options:0
+                usingBlock:^(ENRMSourceAnchor *anchor, NSRange range, BOOL *stop) {
+                  if (![anchor isKindOfClass:ENRMSourceAnchor.class] || anchor.sourceStart < 0 ||
+                      anchor.sourceEnd <= anchor.sourceStart || range.length == 0)
+                    return;
+                  ENRMSourceSelectionTarget *target = [[ENRMSourceSelectionTarget alloc] init];
+                  target.attributedText = text;
+                  target.owner = owner;
+                  target.renderedRange = range;
+                  target.sourceStart = anchor.sourceStart;
+                  target.sourceEnd = anchor.sourceEnd;
+                  target.pill = YES;
+                  target.pillLabel = anchor.label;
+                  [targets addObject:target];
+                }];
+  return targets;
+}
+
+static ENRMSourceSelectionTarget *ENRMTargetByReplacingRange(ENRMSourceSelectionTarget *target, NSRange range)
+{
+  ENRMSourceSelectionTarget *copy = [[ENRMSourceSelectionTarget alloc] init];
+  copy.attributedText = target.attributedText;
+  copy.owner = target.owner;
+  copy.renderedRange = range;
+  copy.sourceStart = target.sourceStart;
+  copy.sourceEnd = target.sourceEnd;
+  copy.tableRow = target.tableRow;
+  copy.tableColumn = target.tableColumn;
+  copy.pill = target.isPill;
+  copy.pillLabel = target.pillLabel;
+  return copy;
+}
+
+static BOOL ENRMResolveLabelAnchors(ENRMSourceSelectionRequest *request, NSArray<ENRMSourceSelectionTarget *> *targets,
+                                    NSMutableDictionary<NSString *, ENRMSourceSelectionTarget *> *resolved)
+{
+  for (ENRMSourceSelectionDisplayLabel *label in request.labels) {
+    NSString *key = ENRMSourceAnchorKey(label.sourceStart, label.sourceEnd);
+    ENRMSourceSelectionTarget *match = nil;
+    for (ENRMSourceSelectionTarget *target in targets) {
+      if (!target.isPill || target.sourceStart != label.sourceStart || target.sourceEnd != label.sourceEnd ||
+          ![target.pillLabel isEqualToString:label.text])
+        continue;
+      if (match)
+        return NO;
+      match = target;
+    }
+    if (!match)
+      return NO;
+    resolved[key] = match;
+  }
+  return YES;
+}
+
+BOOL ENRMResolveSourceSelection(ENRMSourceSelectionRequest *request, NSArray<ENRMSourceSelectionTarget *> *targets,
+                                NSArray<ENRMSourceSelectionTarget *> *_Nullable *_Nullable resolvedTargets)
+{
+  if (!request.isValid || !request.sourceMarkdownMatches || request.requestId.length == 0 ||
+      request.revision.length == 0)
+    return NO;
+
+  NSMutableDictionary<NSString *, ENRMSourceSelectionTarget *> *labels = [NSMutableDictionary dictionary];
+  if (!ENRMResolveLabelAnchors(request, targets, labels))
+    return NO;
+
+  NSMutableArray<ENRMSourceSelectionTarget *> *result = [NSMutableArray array];
+  [labels enumerateKeysAndObjectsUsingBlock:^(NSString *key, ENRMSourceSelectionTarget *target, BOOL *stop) {
+    [result addObject:target];
+  }];
+  for (NSValue *rangeValue in request.ranges) {
+    NSRange sourceRange = rangeValue.rangeValue;
+    NSUInteger cursor = sourceRange.location;
+    NSMutableArray<NSArray<NSNumber *> *> *coverage = [NSMutableArray array];
+    NSUInteger candidates = result.count;
+
+    for (ENRMSourceSelectionTarget *target in targets) {
+      if (target.sourceStart < 0 || target.sourceEnd <= target.sourceStart)
+        continue;
+      NSUInteger start = (NSUInteger)target.sourceStart;
+      NSUInteger end = (NSUInteger)target.sourceEnd;
+      NSUInteger overlapStart = MAX(start, sourceRange.location);
+      NSUInteger overlapEnd = MIN(end, NSMaxRange(sourceRange));
+      if (overlapEnd <= overlapStart)
+        continue;
+
+      NSRange renderedRange = target.renderedRange;
+      if (target.isPill) {
+        NSString *key = ENRMSourceAnchorKey(target.sourceStart, target.sourceEnd);
+        if (labels[key] != target)
+          continue;
+      } else if (target.renderedRange.length == end - start) {
+        renderedRange = NSMakeRange(target.renderedRange.location + overlapStart - start, overlapEnd - overlapStart);
+      } else if (overlapStart != start || overlapEnd != end) {
+        return NO;
+      }
+
+      [coverage addObject:@[ @(overlapStart), @(overlapEnd) ]];
+      [result addObject:ENRMTargetByReplacingRange(target, renderedRange)];
+    }
+
+    if (result.count == candidates)
+      return NO;
+    [coverage sortUsingComparator:^NSComparisonResult(NSArray<NSNumber *> *left, NSArray<NSNumber *> *right) {
+      return [left[0] compare:right[0]];
+    }];
+    for (NSArray<NSNumber *> *span in coverage) {
+      NSUInteger start = span[0].unsignedIntegerValue;
+      NSUInteger end = span[1].unsignedIntegerValue;
+      if (start != cursor || end <= start)
+        return NO;
+      cursor = end;
+    }
+    if (cursor != NSMaxRange(sourceRange))
+      return NO;
+  }
+
+  [result sortUsingComparator:^NSComparisonResult(ENRMSourceSelectionTarget *left, ENRMSourceSelectionTarget *right) {
+    if (left.sourceStart != right.sourceStart)
+      return left.sourceStart < right.sourceStart ? NSOrderedAscending : NSOrderedDescending;
+    if (left.sourceEnd != right.sourceEnd)
+      return left.sourceEnd < right.sourceEnd ? NSOrderedAscending : NSOrderedDescending;
+    if (left.renderedRange.location != right.renderedRange.location)
+      return left.renderedRange.location < right.renderedRange.location ? NSOrderedAscending : NSOrderedDescending;
+    if (left.renderedRange.length != right.renderedRange.length)
+      return left.renderedRange.length < right.renderedRange.length ? NSOrderedAscending : NSOrderedDescending;
+    if (left.isPill != right.isPill)
+      return left.isPill ? NSOrderedDescending : NSOrderedAscending;
+    return NSOrderedSame;
+  }];
+
+  if (resolvedTargets)
+    *resolvedTargets = [result copy];
+  return YES;
+}
+
+NSArray<NSValue *> *ENRMGlyphRectsForRange(NSLayoutManager *layoutManager, NSTextContainer *textContainer,
+                                           NSRange characterRange, CGPoint origin)
+{
+  if (characterRange.length == 0 || NSMaxRange(characterRange) > layoutManager.textStorage.length)
+    return @[];
+  [layoutManager ensureLayoutForTextContainer:textContainer];
+  NSRange actualCharacterRange = NSMakeRange(0, 0);
+  NSRange glyphRange = [layoutManager glyphRangeForCharacterRange:characterRange
+                                             actualCharacterRange:&actualCharacterRange];
+  if (glyphRange.length == 0)
+    return @[];
+
+  NSMutableArray<NSDictionary<NSString *, id> *> *lineRects = [NSMutableArray array];
+  [layoutManager enumerateLineFragmentsForGlyphRange:glyphRange
+                                          usingBlock:^(CGRect lineRect, CGRect usedRect, NSTextContainer *container,
+                                                       NSRange lineGlyphRange, BOOL *stop) {
+                                            NSRange intersection = NSIntersectionRange(glyphRange, lineGlyphRange);
+                                            if (intersection.length == 0)
+                                              return;
+                                            CGRect rect = [layoutManager boundingRectForGlyphRange:intersection
+                                                                                   inTextContainer:textContainer];
+                                            rect = CGRectOffset(rect, origin.x, origin.y);
+                                            if (CGRectGetWidth(rect) <= 0)
+                                              rect.size.width = MAX(CGRectGetWidth(lineRect), 1.0);
+                                            if (CGRectGetHeight(rect) <= 0)
+                                              rect.size.height = CGRectGetHeight(lineRect);
+                                            if (!CGRectIsEmpty(rect)) {
+#if TARGET_OS_OSX
+                                              NSValue *rectValue = [NSValue valueWithRect:rect];
+#else
+          NSValue *rectValue = [NSValue valueWithCGRect:rect];
+#endif
+                                              [lineRects addObject:@{
+                                                @"glyphStart" : @(intersection.location),
+                                                @"rect" : rectValue
+                                              }];
+                                            }
+                                          }];
+  [lineRects
+      sortUsingComparator:^NSComparisonResult(NSDictionary<NSString *, id> *left, NSDictionary<NSString *, id> *right) {
+        return [left[@"glyphStart"] compare:right[@"glyphStart"]];
+      }];
+  NSMutableArray<NSValue *> *rects = [NSMutableArray arrayWithCapacity:lineRects.count];
+  for (NSDictionary<NSString *, id> *entry in lineRects)
+    [rects addObject:entry[@"rect"]];
+  return [rects copy];
+}
+
+void ENRMApplySourceRunsWithRenderLength(MarkdownASTNode *node, NSMutableAttributedString *output,
+                                         NSUInteger outputStart, NSUInteger renderLength)
+{
+  if (!node.sourceRuns.count || output.length == 0)
+    return;
+  for (MarkdownSourceRun *run in node.sourceRuns) {
+    if (run.sourceStart < 0 || run.sourceEnd <= run.sourceStart || run.renderStart < 0 ||
+        run.renderEnd <= run.renderStart || (NSUInteger)run.renderEnd > renderLength)
+      continue;
+    NSRange range =
+        NSMakeRange(outputStart + (NSUInteger)run.renderStart, (NSUInteger)(run.renderEnd - run.renderStart));
+    if (NSMaxRange(range) <= output.length)
+      [output addAttribute:ENRMSourceRunAttributeName value:run range:range];
+  }
+}
+
+void ENRMApplySourceRuns(MarkdownASTNode *node, NSMutableAttributedString *output, NSUInteger outputStart)
+{
+  ENRMApplySourceRunsWithRenderLength(node, output, outputStart, node.content.length);
+}
+
+void ENRMTrimSourceRunsToLength(NSMutableAttributedString *attributedText, NSUInteger length)
+{
+  if (length >= attributedText.length)
+    return;
+
+  NSRange fullRange = NSMakeRange(0, attributedText.length);
+  NSMutableArray<NSArray *> *clippedRuns = [NSMutableArray array];
+  [attributedText enumerateAttribute:ENRMSourceRunAttributeName
+                             inRange:fullRange
+                             options:0
+                          usingBlock:^(MarkdownSourceRun *run, NSRange range, BOOL *stop) {
+                            if (![run isKindOfClass:MarkdownSourceRun.class] || NSMaxRange(range) <= length ||
+                                range.location >= length)
+                              return;
+                            NSUInteger visibleLength = length - range.location;
+                            [clippedRuns addObject:@[ run, [NSValue valueWithRange:range], @(visibleLength) ]];
+                          }];
+
+  for (NSArray *entry in clippedRuns) {
+    MarkdownSourceRun *run = entry[0];
+    NSRange range = [entry[1] rangeValue];
+    NSUInteger visibleLength = [entry[2] unsignedIntegerValue];
+    NSRange visibleRange = NSMakeRange(range.location, visibleLength);
+    [attributedText removeAttribute:ENRMSourceRunAttributeName range:visibleRange];
+
+    if (run.sourceStart < 0 || run.sourceEnd - run.sourceStart != (NSInteger)range.length ||
+        run.renderEnd - run.renderStart != (NSInteger)range.length)
+      continue;
+
+    MarkdownSourceRun *clipped = [[MarkdownSourceRun alloc] init];
+    clipped.sourceStart = run.sourceStart;
+    clipped.sourceEnd = run.sourceStart + (NSInteger)visibleLength;
+    clipped.renderStart = run.renderStart;
+    clipped.renderEnd = run.renderStart + (NSInteger)visibleLength;
+    [attributedText addAttribute:ENRMSourceRunAttributeName value:clipped range:visibleRange];
+  }
+
+  [attributedText deleteCharactersInRange:NSMakeRange(length, attributedText.length - length)];
+}
+
+CGFloat ENRMHorizontalOffsetToRevealRect(CGRect rectInContent, CGRect viewportBounds, CGFloat currentOffset,
+                                         CGFloat minimumOffset, CGFloat maximumOffset)
+{
+  CGFloat delta = 0;
+  if (CGRectGetMinX(rectInContent) < CGRectGetMinX(viewportBounds))
+    delta = CGRectGetMinX(rectInContent) - CGRectGetMinX(viewportBounds);
+  else if (CGRectGetMaxX(rectInContent) > CGRectGetMaxX(viewportBounds))
+    delta = CGRectGetMaxX(rectInContent) - CGRectGetMaxX(viewportBounds);
+  return MIN(MAX(currentOffset + delta, minimumOffset), maximumOffset);
+}
+
+NSDictionary<NSString *, NSString *> *
+ENRMSourceLinkPillContentForRenderedMarkdown(NSDictionary<NSString *, NSString *> *sourceContent,
+                                             NSString *sourceMarkdown, NSString *renderedMarkdown)
+{
+  return [sourceMarkdown isEqualToString:renderedMarkdown] ? sourceContent : @{};
+}
+
+BOOL ENRMSourceLinkPillContentDidChange(NSDictionary<NSString *, NSString *> *previous,
+                                        NSDictionary<NSString *, NSString *> *current)
+{
+  return ![previous isEqualToDictionary:current];
+}
