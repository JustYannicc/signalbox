+#import "ENRMSourceSelectionOverlayView.h"
+
+#if !TARGET_OS_OSX
+@implementation ENRMSourceSelectionOverlayView
+
+- (instancetype)initWithFrame:(CGRect)frame
+{
+  if (self = [super initWithFrame:frame]) {
+    self.backgroundColor = UIColor.clearColor;
+    self.userInteractionEnabled = NO;
+    self.accessibilityElementsHidden = YES;
+    self.isAccessibilityElement = NO;
+    _rects = @[];
+  }
+  return self;
+}
+
+- (void)setRects:(NSArray<NSValue *> *)rects
+{
+  if ([_rects isEqualToArray:rects])
+    return;
+  _rects = [rects copy];
+  [self setNeedsDisplay];
+}
+
+- (void)drawRect:(CGRect)rect
+{
+  UIColor *color = [UIColor.systemYellowColor colorWithAlphaComponent:0.30];
+  [color setFill];
+  for (NSValue *value in _rects) {
+    CGRect highlight = CGRectInset(value.CGRectValue, -1.5, -0.5);
+    [[UIBezierPath bezierPathWithRoundedRect:highlight cornerRadius:3.0] fill];
+  }
+}
+
+@end
+#endif
