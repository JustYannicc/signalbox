+static BOOL ENRMJSONInteger(id value, NSInteger *outValue)
+{
+  if (![value isKindOfClass:NSNumber.class] || CFGetTypeID((__bridge CFTypeRef)value) == CFBooleanGetTypeID())
+    return NO;
+  double number = [value doubleValue];
+  if (!isfinite(number) || trunc(number) != number || number < 0 || number > (double)NSIntegerMax)
+    return NO;
+  if (outValue)
+    *outValue = (NSInteger)number;
+  return YES;
+}
+
+static BOOL ENRMIsUTF16ScalarBoundary(NSString *text, NSInteger offset)
+{
+  if (offset < 0 || (NSUInteger)offset > text.length)
+    return NO;
+  if (offset == 0 || (NSUInteger)offset == text.length)
+    return YES;
+  unichar before = [text characterAtIndex:(NSUInteger)offset - 1];
+  unichar after = [text characterAtIndex:(NSUInteger)offset];
+  return !(before >= 0xD800 && before <= 0xDBFF && after >= 0xDC00 && after <= 0xDFFF);
+}
