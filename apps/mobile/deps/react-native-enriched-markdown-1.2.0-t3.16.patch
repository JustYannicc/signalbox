+static void ENRMTestBreakMappingAndCodeTrim(void)
+{
+  MarkdownASTNode *breakNode = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeSoftBreak];
+  MarkdownSourceRun *breakRun = [[MarkdownSourceRun alloc] init];
+  breakRun.sourceStart = 1;
+  breakRun.sourceEnd = 3;
+  breakRun.renderStart = 0;
+  breakRun.renderEnd = 1;
+  [breakNode.sourceRuns addObject:breakRun];
+  NSMutableAttributedString *separator = [[NSMutableAttributedString alloc] initWithString:@" "];
+  ENRMApplySourceRunsWithRenderLength(breakNode, separator, 0, 1);
+  ENRMSourceSelectionRequest *breakSelection = ENRMTestSelection(@"break", @"a\r\nb", @[ @{
+                                                                   @"start" : @1,
+                                                                   @"end" : @3
+                                                                 } ],
+                                                                 nil);
+  NSArray *breakTargets = ENRMSourceSelectionTargets(separator, [NSObject new]);
+  NSCAssert(breakTargets.count == 1 && ENRMResolveSourceSelection(breakSelection, breakTargets, nil),
+            @"empty-content break nodes map their emitted separator");
+
+  NSMutableAttributedString *code = [[NSMutableAttributedString alloc] initWithString:@"abc\n"];
+  MarkdownSourceRun *codeRun = [[MarkdownSourceRun alloc] init];
+  codeRun.sourceStart = 4;
+  codeRun.sourceEnd = 8;
+  codeRun.renderStart = 0;
+  codeRun.renderEnd = 4;
+  [code addAttribute:ENRMSourceRunAttributeName value:codeRun range:NSMakeRange(0, 4)];
+  ENRMTrimSourceRunsToLength(code, 3);
+  NSArray<ENRMSourceSelectionTarget *> *codeTargets = ENRMSourceSelectionTargets(code, [NSObject new]);
+  unichar fence = 0x0060;
+  NSString *fencedMarkdown =
+      [NSString stringWithFormat:@"%C%C%C\nabc\n%C%C%C", fence, fence, fence, fence, fence, fence];
+  ENRMSourceSelectionRequest *trimmedCode = ENRMTestSelection(@"code", fencedMarkdown, @[ @{
+                                                                @"start" : @4,
+                                                                @"end" : @7
+                                                              } ],
+                                                              nil);
+  NSCAssert(code.length == 3 && codeTargets.count == 1 && codeTargets[0].sourceEnd == 7,
+            @"fenced code trimming clips the final-newline source mapping");
+  NSCAssert(ENRMResolveSourceSelection(trimmedCode, codeTargets, nil),
+            @"visible code remains selectable after trimming the final newline");
+}
