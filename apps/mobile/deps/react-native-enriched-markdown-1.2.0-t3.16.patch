+size_t utf8ScalarLength(const std::string &text, size_t offset) {
+  const auto lead = static_cast<unsigned char>(text[offset]);
+  const size_t expected = lead < 0x80 ? 1 : lead < 0xE0 ? 2 : lead < 0xF0 ? 3 : 4;
+  if (offset + expected > text.size())
+    return 1;
+  for (size_t i = 1; i < expected; ++i) {
+    if ((static_cast<unsigned char>(text[offset + i]) & 0xC0) != 0x80)
+      return 1;
+  }
+  return expected;
+}
