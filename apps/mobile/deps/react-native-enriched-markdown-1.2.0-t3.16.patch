--- /dev/null
+++ b/packages/react-native-enriched-markdown/src/sourceSelection.ts
@@ -0,0 +1,68 @@
+import type {
+  MarkdownSourceSelection,
+  MarkdownSourceSelectionResult,
+} from './types/sourceSelection';
+import type { NativeSyntheticEvent } from 'react-native';
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function isFiniteNumber(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value);
+}
+
+export function isCurrentSourceSelectionResult(
+  result: unknown,
+  selection: MarkdownSourceSelection | null | undefined,
+  markdown: string,
+  revision: string | undefined
+): result is MarkdownSourceSelectionResult {
+  if (
+    !isObject(result) ||
+    !selection ||
+    selection.version !== 1 ||
+    !selection.requestId ||
+    result.version !== 1 ||
+    !revision ||
+    typeof result.revision !== 'string' ||
+    typeof result.requestId !== 'string' ||
+    result.revision !== revision ||
+    result.revision !== selection.revision ||
+    result.requestId !== selection.requestId ||
+    (result.status !== 'applied' && result.status !== 'rejected') ||
+    !Array.isArray(result.rects)
+  ) {
+    return false;
+  }
+  if (result.status === 'rejected') return result.rects.length === 0;
+  if (selection.sourceMarkdown !== markdown || result.rects.length === 0)
+    return false;
+  for (const rect of result.rects) {
+    if (
+      !isObject(rect) ||
+      !isFiniteNumber(rect.x) ||
+      !isFiniteNumber(rect.y) ||
+      !isFiniteNumber(rect.width) ||
+      !isFiniteNumber(rect.height) ||
+      rect.width <= 0 ||
+      rect.height <= 0
+    )
+      return false;
+  }
+  return true;
+}
+
+export function isCurrentSourceSelectionEvent(
+  event: NativeSyntheticEvent<unknown>,
+  selection: MarkdownSourceSelection | null | undefined,
+  markdown: string,
+  revision: string | undefined
+): event is NativeSyntheticEvent<MarkdownSourceSelectionResult> {
+  return isCurrentSourceSelectionResult(
+    event.nativeEvent,
+    selection,
+    markdown,
+    revision
+  );
+}
