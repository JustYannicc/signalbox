+static void ENRMTestGlyphRectsFollowCharacterOrder(void)
+{
+  NSAttributedString *text = [[NSAttributedString alloc] initWithString:@"first\nsecond\nthird"];
+  NSTextStorage *storage = [[NSTextStorage alloc] initWithAttributedString:text];
+  NSLayoutManager *layoutManager = [[NSLayoutManager alloc] init];
+#if TARGET_OS_OSX
+  NSTextContainer *textContainer = [[NSTextContainer alloc] initWithContainerSize:NSMakeSize(300, 300)];
+#else
+  NSTextContainer *textContainer = [[NSTextContainer alloc] initWithSize:CGSizeMake(300, 300)];
+#endif
+  textContainer.lineFragmentPadding = 0;
+  [layoutManager addTextContainer:textContainer];
+  [storage addLayoutManager:layoutManager];
+  [layoutManager ensureLayoutForTextContainer:textContainer];
+
+  NSRange characterRange = NSMakeRange(0, text.length);
+  NSRange glyphRange = [layoutManager glyphRangeForCharacterRange:characterRange actualCharacterRange:nil];
+  NSRange firstLineRange = NSMakeRange(0, 0);
+  CGRect firstLine = [layoutManager lineFragmentRectForGlyphAtIndex:glyphRange.location effectiveRange:&firstLineRange];
+  NSRange secondLineRange = NSMakeRange(0, 0);
+  CGRect secondLine = [layoutManager lineFragmentRectForGlyphAtIndex:NSMaxRange(firstLineRange)
+                                                      effectiveRange:&secondLineRange];
+  BOOL yIncreasesWithSource = CGRectGetMinY(secondLine) > CGRectGetMinY(firstLine);
+  NSArray<NSValue *> *rects = ENRMGlyphRectsForRange(layoutManager, textContainer, characterRange, CGPointZero);
+  NSCAssert(rects.count >= 3, @"the selection spans all three rendered lines");
+
+  CGFloat previousY = yIncreasesWithSource ? -CGFLOAT_MAX : CGFLOAT_MAX;
+  for (NSValue *value in rects) {
+#if TARGET_OS_OSX
+    CGRect rect = value.rectValue;
+#else
+    CGRect rect = value.CGRectValue;
+#endif
+    CGFloat y = CGRectGetMinY(rect);
+    NSCAssert(yIncreasesWithSource ? y >= previousY : y <= previousY,
+              @"line glyph rectangles follow the selected characters instead of visual sorting");
+    previousY = y;
+  }
+}
