+static void ENRMTestTableHorizontalRevealUsesViewportOrigin(void)
+{
+  CGFloat offset = 500;
+  CGRect viewport = CGRectMake(offset, 0, 400, 200);
+  CGRect right = CGRectMake(1000, 20, 20, 20);
+  offset = ENRMHorizontalOffsetToRevealRect(right, viewport, offset, 0, 1500);
+  NSCAssert(offset == 620, @"a right-side result scrolls into the actual viewport");
+
+  viewport.origin.x = offset;
+  CGRect left = CGRectMake(50, 20, 20, 20);
+  offset = ENRMHorizontalOffsetToRevealRect(left, viewport, offset, 0, 1500);
+  NSCAssert(offset == 50, @"a previous result scrolls back left after the right-side reveal");
+
+  viewport.origin.x = offset;
+  offset = ENRMHorizontalOffsetToRevealRect(right, viewport, offset, 0, 1500);
+  NSCAssert(offset == 620, @"next/previous navigation continues to alternate across the table");
+}
