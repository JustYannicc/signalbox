+static void ENRMFindInlineCodeNode(std::shared_ptr<Markdown::MarkdownASTNode> node,
+                                   std::shared_ptr<Markdown::MarkdownASTNode> *result)
+{
+  if (node->type == Markdown::NodeType::Code)
+    *result = node;
+  for (const auto &child : node->children)
+    ENRMFindInlineCodeNode(child, result);
+}
+
+static MarkdownASTNode *ENRMObjectiveCInlineCodeNode(std::shared_ptr<Markdown::MarkdownASTNode> cppNode)
+{
+  MarkdownASTNode *node = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeCode];
+  for (const auto &cppChild : cppNode->children) {
+    MarkdownASTNode *child = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeText];
+    child.content = [[NSString alloc] initWithBytes:cppChild->content.data()
+                                             length:cppChild->content.size()
+                                           encoding:NSUTF8StringEncoding];
+    for (const auto &cppRun : cppChild->sourceRuns) {
+      MarkdownSourceRun *run = [[MarkdownSourceRun alloc] init];
+      run.sourceStart = cppRun.sourceStart;
+      run.sourceEnd = cppRun.sourceEnd;
+      run.renderStart = cppRun.renderStart;
+      run.renderEnd = cppRun.renderEnd;
+      [child.sourceRuns addObject:run];
+    }
+    [node addChild:child];
+  }
+  return node;
+}
