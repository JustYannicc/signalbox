index 0000000000000000000000000000000000000000..a844d30c8cf73c98fab46c1cf85c8059a79ef69c
--- /dev/null
+++ b/packages/react-native-enriched-markdown/__tests__/source-selection-event.test.tsx
@@ -0,0 +1,79 @@
+import { act } from 'react';
+import { createRoot } from 'test-renderer';
+import { EnrichedMarkdownText } from '../src/native/EnrichedMarkdownText';
+import type { NativeSyntheticEvent } from 'react-native';
+import type { MarkdownSourceSelectionResult } from '../src/types/sourceSelection';
+
+jest.mock('../src/EnrichedMarkdownNativeComponent', () => ({
+  __esModule: true,
+  default: 'EnrichedMarkdownNativeComponent',
+}));
+jest.mock('../src/EnrichedMarkdownTextNativeComponent', () => ({
+  __esModule: true,
+  default: 'EnrichedMarkdownTextNativeComponent',
+}));
+
+class SourceEvent {
+  nativeEvent = {
+    version: 1,
+    revision: 'revision-1',
+    requestId: 'request-1',
+    status: 'applied',
+    rects: [{ x: 0, y: 0, width: 4, height: 8 }],
+  };
+  persisted = false;
+  defaultPrevented = false;
+  propagationStopped = false;
+
+  persist() {
+    this.persisted = true;
+  }
+  preventDefault() {
+    this.defaultPrevented = true;
+  }
+  stopPropagation() {
+    this.propagationStopped = true;
+  }
+}
+
+it('preserves the native event and its prototype methods in the public callback', () => {
+  const onSourceSelection = jest.fn(
+    (event: NativeSyntheticEvent<MarkdownSourceSelectionResult>) => {
+      event.persist();
+      event.preventDefault();
+      event.stopPropagation();
+    }
+  );
+  const root = createRoot({
+    textComponentTypes: ['EnrichedMarkdownNativeComponent'],
+  });
+  act(() =>
+    root.render(
+      <EnrichedMarkdownText
+        markdown="text"
+        flavor="github"
+        sourceDocumentRevision="revision-1"
+        sourceSelection={{
+          version: 1,
+          revision: 'revision-1',
+          requestId: 'request-1',
+          sourceMarkdown: 'text',
+          ranges: [{ start: 0, end: 4 }],
+        }}
+        onSourceSelection={onSourceSelection}
+      />
+    )
+  );
+  const [view] = root.container.queryAll(
+    (instance) => instance.type === 'EnrichedMarkdownNativeComponent'
+  );
+  if (!view) throw new Error('Native markdown view was not rendered');
+  const event = new SourceEvent();
+  act(() => view.props.onSourceSelection(event));
+  expect(onSourceSelection).toHaveBeenCalledTimes(1);
+  expect(onSourceSelection.mock.calls[0]?.[0]).toBe(event);
+  expect(event.persisted).toBe(true);
+  expect(event.defaultPrevented).toBe(true);
+  expect(event.propagationStopped).toBe(true);
+  act(() => root.unmount());
+});
diff --git a/packages/react-native-enriched-markdown/__tests__/source-selection.test.ts b/packages/react-native-enriched-markdown/__tests__/source-selection.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ba08e1a83ef159d5ff9e47280850a0c457f5c4ac
--- /dev/null
+++ b/packages/react-native-enriched-markdown/__tests__/source-selection.test.ts
@@ -0,0 +1,119 @@
+import { isCurrentSourceSelectionResult } from '../src/sourceSelection';
+import type { MarkdownSourceSelection } from '../src/types/sourceSelection';
+
+const markdown = 'same\n\nsame 😀';
+const selection: MarkdownSourceSelection = {
+  version: 1,
+  revision: 'document-2',
+  requestId: 'next-4',
+  sourceMarkdown: markdown,
+  ranges: [{ start: 6, end: 10 }],
+};
+const applied = {
+  version: 1,
+  revision: selection.revision,
+  requestId: selection.requestId,
+  status: 'applied',
+  rects: [{ x: 8, y: 620, width: 34, height: 20 }],
+};
+
+it('accepts only the current request and exact rendered document', () => {
+  expect(
+    isCurrentSourceSelectionResult(applied, selection, markdown, 'document-2')
+  ).toBe(true);
+  for (const result of [
+    { ...applied, requestId: 'previous-3' },
+    { ...applied, revision: 'document-1' },
+    { ...applied, version: 2 },
+    { ...applied, status: 'pending' },
+  ]) {
+    expect(
+      isCurrentSourceSelectionResult(result, selection, markdown, 'document-2')
+    ).toBe(false);
+  }
+  expect(
+    isCurrentSourceSelectionResult(applied, selection, 'same', 'document-2')
+  ).toBe(false);
+  expect(
+    isCurrentSourceSelectionResult(applied, selection, markdown, 'document-3')
+  ).toBe(false);
+  expect(
+    isCurrentSourceSelectionResult(applied, null, markdown, 'document-2')
+  ).toBe(false);
+});
+
+it('never completes reveal from an empty or invalid glyph rectangle', () => {
+  for (const rects of [
+    [],
+    [{ x: 0, y: NaN, width: 3, height: 8 }],
+    [{ x: Infinity, y: 0, width: 3, height: 8 }],
+    [{ x: 0, y: 0, width: 0, height: 8 }],
+    [{ x: 0, y: 0, width: 3, height: -1 }],
+  ]) {
+    expect(
+      isCurrentSourceSelectionResult(
+        { ...applied, rects },
+        selection,
+        markdown,
+        selection.revision
+      )
+    ).toBe(false);
+  }
+});
+
+it('rejects malformed runtime payloads without throwing', () => {
+  for (const result of [
+    null,
+    undefined,
+    1,
+    'applied',
+    [],
+    {},
+    { ...applied, revision: 2 },
+    { ...applied, requestId: null },
+    { ...applied, rects: null },
+    { ...applied, rects: { length: 1 } },
+    { ...applied, rects: [null] },
+    { ...applied, rects: [undefined] },
+    { ...applied, rects: new Array(1) },
+    { ...applied, rects: [{ x: '8', y: 0, width: 1, height: 1 }] },
+    { ...applied, rects: [{ x: 0, y: 0, width: 1 }] },
+    { ...applied, status: 'rejected', rects: { length: 0 } },
+  ]) {
+    expect(
+      isCurrentSourceSelectionResult(
+        result,
+        selection,
+        markdown,
+        selection.revision
+      )
+    ).toBe(false);
+  }
+});
+
+it('forwards a current rejection only when it contains no highlight', () => {
+  expect(
+    isCurrentSourceSelectionResult(
+      { ...applied, status: 'rejected', rects: [] },
+      selection,
+      markdown,
+      selection.revision
+    )
+  ).toBe(true);
+  expect(
+    isCurrentSourceSelectionResult(
+      { ...applied, status: 'rejected', rects: [] },
+      selection,
+      'different source',
+      selection.revision
+    )
+  ).toBe(true);
+  expect(
+    isCurrentSourceSelectionResult(
+      { ...applied, status: 'rejected' },
+      selection,
+      markdown,
+      selection.revision
+    )
+  ).toBe(false);
+});
