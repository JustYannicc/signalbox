+            @"a complete supplementary scalar resolves across both UTF-16 units");
+
+  ENRMSourceSelectionRequest *entity = ENRMTestSelection(@"entity", @"&amp;", @[ @{@"start" : @0, @"end" : @5} ], nil);
+  NSCAssert(entity.isValid && ENRMResolveSourceSelection(entity, @[ ENRMTestTarget(0, 5, 0, 1, NO, nil) ], nil),
+            @"a complete source entity can resolve to its decoded scalar");
