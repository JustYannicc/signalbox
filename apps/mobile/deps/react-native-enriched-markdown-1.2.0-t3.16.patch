+static void ENRMTestMalformedRequestKeepsUsableIdentity(void)
+{
+  ENRMSourceSelectionRequest *request = ENRMTestSelection(@"bad-range", @"abcd", @[ @{
+                                                            @"start" : @1,
+                                                            @"end" : @1
+                                                          } ],
+                                                          nil);
+  NSCAssert(request != nil && [request.requestId isEqualToString:@"bad-range"] && !request.isValid,
+            @"malformed requests with usable IDs must be rejectable");
+  NSCAssert(!ENRMResolveSourceSelection(request, @[], nil), @"malformed requests cannot resolve as empty selections");
+
+  ENRMSourceSelectionRequest *partlyParsed = ENRMTestSelection(@"partial", @"abcd", @[
+    @{@"start" : @0,
+      @"end" : @2},
+    @{@"start" : @3,
+      @"end" : @3}
+  ],
+                                                               nil);
+  NSCAssert(!partlyParsed.isValid &&
+                !ENRMResolveSourceSelection(partlyParsed, @[ ENRMTestTarget(0, 2, 0, 2, NO, nil) ], nil),
+            @"a valid prefix cannot resolve when a later range is malformed");
+
+  NSDictionary *stalePayload = @{
+    @"version" : @1,
+    @"revision" : @"revision-1",
+    @"requestId" : @"stale-source",
+    @"sourceMarkdown" : @"abcd",
+    @"ranges" : @[
+      @{@"start" : @0,
+        @"end" : @2}
+    ]
+  };
+  NSData *staleJSON = [NSJSONSerialization dataWithJSONObject:stalePayload options:0 error:nil];
+  ENRMSourceSelectionRequest *staleSource =
+      ENRMParseSourceSelection([[NSString alloc] initWithData:staleJSON encoding:NSUTF8StringEncoding], @"abcd!");
+  NSCAssert(staleSource.isValid && !staleSource.sourceMarkdownMatches &&
+                !ENRMResolveSourceSelection(staleSource, @[ ENRMTestTarget(0, 2, 0, 2, NO, nil) ], nil),
+            @"selection source identity must match the renderer input exactly");
+}
