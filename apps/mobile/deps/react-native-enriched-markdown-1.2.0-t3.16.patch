@@ -0,0 +1,46 @@
+/** UTF-16 offsets into the exact Markdown passed to the renderer, end-exclusive. */
+export interface MarkdownSourceRange {
+  start: number;
+  end: number;
+}
+
+export interface MarkdownDisplayLabelRange extends MarkdownSourceRange {
+  kind: 'link-label';
+  /** The parsed link label's source bounds, or the full recognized autolink. */
+  sourceStart: number;
+  sourceEnd: number;
+  /** Must equal the resolved native pill label. Partial matches reveal its whole attachment. */
+  text: string;
+}
+
+/** Overrides one parsed link label while preserving its existing pill icon and style. */
+export interface MarkdownSourceLinkPillContent {
+  sourceStart: number;
+  sourceEnd: number;
+  label: string;
+}
+
+export interface MarkdownSourceSelection {
+  version: 1;
+  revision: string;
+  requestId: string;
+  sourceMarkdown: string;
+  ranges: readonly MarkdownSourceRange[];
+  labels?: readonly MarkdownDisplayLabelRange[];
+}
+
+export interface MarkdownSourceSelectionRect {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+export interface MarkdownSourceSelectionResult {
+  version: 1;
+  revision: string;
+  requestId: string;
+  status: 'applied' | 'rejected';
+  /** Renderer-root coordinates, measured after horizontal overflow has been revealed. */
+  rects: readonly MarkdownSourceSelectionRect[];
+}
