+static void ENRMTestActualInlineCodeRendererPreservesSourceRuns(void)
+{
+  NSString *markdown = @"`a\r\nb`";
+  Markdown::MD4CParser parser;
+  Markdown::Md4cFlags flags;
+  flags.permissiveAutolinks = false;
+  std::shared_ptr<Markdown::MarkdownASTNode> code;
+  ENRMFindInlineCodeNode(parser.parse(std::string(markdown.UTF8String), flags), &code);
+  NSCAssert(code != nullptr, @"the actual parser must produce the inline-code fixture");
+
+  MarkdownASTNode *objcCode = ENRMObjectiveCInlineCodeNode(code);
+  NSMutableAttributedString *parsedPreview = [[NSMutableAttributedString alloc] init];
+  for (MarkdownASTNode *child in objcCode.children) {
+    NSUInteger start = parsedPreview.length;
+    [parsedPreview appendAttributedString:[[NSAttributedString alloc] initWithString:child.content]];
+    ENRMApplySourceRuns(child, parsedPreview, start);
+  }
+  NSCAssert([parsedPreview.string isEqualToString:@"a b"], @"the parser normalizes CRLF for inline code");
+  NSArray<ENRMSourceSelectionTarget *> *beforeStyling = ENRMSourceSelectionTargets(parsedPreview, [NSObject new]);
+  NSCAssert(beforeStyling.count == 3, @"the parser provides distinct mappings for both glyphs and CRLF");
+
+  NSURL *firstCharacterLink = [NSURL URLWithString:@"https://example.com/first"];
+  BlockStyle *blockStyle = [BlockStyle new];
+  blockStyle.cachedFont = [NSFont systemFontOfSize:12];
+  ENRMHostRenderContext *context = [ENRMHostRenderContext new];
+  context.style = blockStyle;
+  context.allowFontScaling = NO;
+  context.maxFontSizeMultiplier = 1.0;
+  StyleConfig *config = [StyleConfig new];
+  config.codeFontSize = 12;
+  ENRMHostRendererFactory *factory = [ENRMHostRendererFactory new];
+  factory.firstCharacterLink = firstCharacterLink;
+  CodeRenderer *renderer = [[CodeRenderer alloc] initWithRendererFactory:(id)factory config:config];
+  NSMutableAttributedString *rendered = [[NSMutableAttributedString alloc] init];
+  [renderer renderNodeContent:objcCode into:rendered context:(RenderContext *)context];
+  NSCAssert([rendered.string isEqualToString:@"a b"], @"production CodeRenderer renders the parser-derived node once");
+
+  NSCAssert([[rendered attribute:NSLinkAttributeName atIndex:0 effectiveRange:NULL] isEqual:firstCharacterLink],
+            @"code styling preserves the first run's link metadata");
+  NSCAssert([rendered attribute:NSLinkAttributeName atIndex:2 effectiveRange:NULL] == nil,
+            @"code styling does not copy the first run's link metadata to later runs");
+
+  NSArray<ENRMSourceSelectionTarget *> *targets = ENRMSourceSelectionTargets(rendered, [NSObject new]);
+  NSCAssert(targets.count == 3, @"inline-code styling cannot collapse parser-owned runs");
+  ENRMSourceSelectionRequest *firstGlyph = ENRMTestSelection(@"code-a", markdown, @[ @{
+                                                               @"start" : @1,
+                                                               @"end" : @2
+                                                             } ],
+                                                             nil);
+  ENRMSourceSelectionRequest *secondGlyph = ENRMTestSelection(@"code-b", markdown, @[ @{
+                                                                @"start" : @4,
+                                                                @"end" : @5
+                                                              } ],
+                                                              nil);
+  NSArray<ENRMSourceSelectionTarget *> *resolvedA = nil;
+  NSArray<ENRMSourceSelectionTarget *> *resolvedB = nil;
+  NSCAssert(ENRMResolveSourceSelection(firstGlyph, targets, &resolvedA) && resolvedA.count == 1 &&
+                resolvedA[0].renderedRange.length == 1,
+            @"the first source glyph highlights only itself after CodeRenderer styling");
+  NSCAssert(ENRMResolveSourceSelection(secondGlyph, targets, &resolvedB) && resolvedB.count == 1 &&
+                resolvedB[0].renderedRange.location == 2 && resolvedB[0].renderedRange.length == 1,
+            @"the glyph after normalized CRLF remains independently selectable");
+}
