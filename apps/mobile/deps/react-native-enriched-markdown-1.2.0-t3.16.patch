+static void ENRMTestStreamingRestoresSourcePillLabels(void)
+{
+  NSString *pending = @"[Title](url)\n\n| A |\n| --- |\n| partial";
+  NSString *completed = @"[Title](url)\n\n| A |\n| --- |\n| complete |";
+  NSString *pendingRendered = ENRMRenderableMarkdownForStreaming(pending, ENRMTableStreamingModeProgressive,
+                                                                 ENRMCodeBlockStreamingModeProgressive, NULL);
+  NSString *completedRendered = ENRMRenderableMarkdownForStreaming(completed, ENRMTableStreamingModeProgressive,
+                                                                   ENRMCodeBlockStreamingModeProgressive, NULL);
+  NSCAssert(![pendingRendered isEqualToString:pending] && [completedRendered isEqualToString:completed],
+            @"the fixture crosses the real pending-row filter boundary");
+
+  NSDictionary<NSString *, NSString *> *sourceContent = @{@"1:6" : @"Source title"};
+  NSDictionary<NSString *, NSString *> *filteredContent =
+      ENRMSourceLinkPillContentForRenderedMarkdown(sourceContent, pending, pendingRendered);
+  NSDictionary<NSString *, NSString *> *completedContent =
+      ENRMSourceLinkPillContentForRenderedMarkdown(sourceContent, completed, completedRendered);
+  NSDictionary<NSString *, NSString *> *stoppedStreamingContent =
+      ENRMSourceLinkPillContentForRenderedMarkdown(sourceContent, pending, pending);
+  NSCAssert(filteredContent.count == 0 && completedContent.count == 1 && stoppedStreamingContent.count == 1,
+            @"pending rows suppress source labels; completion and stopped streaming restore them");
+  NSCAssert(ENRMSourceLinkPillContentDidChange(filteredContent, completedContent) &&
+                !ENRMSourceLinkPillContentDidChange(completedContent, completedContent) &&
+                ENRMSourceLinkPillContentDidChange(filteredContent, stoppedStreamingContent),
+            @"changes in effective pill labels invalidate reused rendered segments");
+}
