+#include "MD4CParser.hpp"
+#include "TextLinkRecognizer.hpp"
+
+#include <cassert>
+#include <cstddef>
+#include <functional>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+using Markdown::MarkdownASTNode;
+using Markdown::NodeType;
+using Markdown::SourceRun;
+
+namespace {
+
+int utf16Length(const std::string &value) {
+  int count = 0;
+  for (size_t i = 0; i < value.size();) {
+    const unsigned char lead = static_cast<unsigned char>(value[i]);
+    const size_t size = lead < 0x80 ? 1 : lead < 0xE0 ? 2 : lead < 0xF0 ? 3 : 4;
+    count += size == 4 ? 2 : 1;
+    i += size;
+  }
+  return count;
+}
+
+void visit(const std::shared_ptr<MarkdownASTNode> &node, const std::function<void(const MarkdownASTNode &)> &visitor) {
+  visitor(*node);
+  for (const auto &child : node->children)
+    visit(child, visitor);
+}
+
+std::vector<std::shared_ptr<MarkdownASTNode>> collect(const std::shared_ptr<MarkdownASTNode> &root, NodeType type) {
+  std::vector<std::shared_ptr<MarkdownASTNode>> matches;
+  std::function<void(const std::shared_ptr<MarkdownASTNode> &)> collectNode =
+      [&matches, type, &collectNode](const std::shared_ptr<MarkdownASTNode> &node) {
+        if (node->type == type)
+          matches.push_back(node);
+        for (const auto &child : node->children)
+          collectNode(child);
+      };
+  collectNode(root);
+  return matches;
+}
+
+std::shared_ptr<MarkdownASTNode> first(const std::shared_ptr<MarkdownASTNode> &root, NodeType type) {
+  const auto matches = collect(root, type);
+  return matches.empty() ? nullptr : matches.front();
+}
+
+void assertRun(const SourceRun &run, int sourceStart, int sourceEnd, int renderStart, int renderEnd) {
+  assert(run.sourceStart == sourceStart);
+  assert(run.sourceEnd == sourceEnd);
+  assert(run.renderStart == renderStart);
+  assert(run.renderEnd == renderEnd);
+}
+
+void assertTextRunsCoverContent(const std::shared_ptr<MarkdownASTNode> &root) {
+  visit(root, [](const MarkdownASTNode &node) {
+    if (node.type != NodeType::Text || node.content.empty())
+      return;
+    int renderOffset = 0;
+    for (const SourceRun &run : node.sourceRuns) {
+      assert(run.renderStart == renderOffset);
+      assert(run.renderEnd > run.renderStart);
+      if (run.sourceStart < 0 || run.sourceEnd < 0)
+        assert(run.sourceStart == -1 && run.sourceEnd == -1);
+      else
+        assert(run.sourceEnd > run.sourceStart);
+      renderOffset = run.renderEnd;
+    }
+    assert(renderOffset == utf16Length(node.content));
+  });
+}
+
+} // namespace
+
+int main() {
+  Markdown::MD4CParser parser;
+  Markdown::Md4cFlags flags;
+  flags.permissiveAutolinks = false;
+
+  {
+    const auto root = parser.parse("same &amp; same", flags);
+    const auto text = first(root, NodeType::Text);
+    assert(text && text->content == "same & same");
+    assert(text->sourceRuns.size() == 3);
+    assertRun(text->sourceRuns[0], 0, 5, 0, 5);
+    assertRun(text->sourceRuns[1], 5, 10, 5, 6);
+    assertRun(text->sourceRuns[2], 10, 15, 6, 11);
+    assertTextRunsCoverContent(root);
+  }
+
+  {
+    const auto root = parser.parse("same \\* same", flags);
+    const auto text = first(root, NodeType::Text);
+    assert(text && text->content == "same * same");
+    assert(text->sourceRuns.size() == 3);
+    assertRun(text->sourceRuns[0], 0, 5, 0, 5);
+    assertRun(text->sourceRuns[1], 5, 7, 5, 6);
+    assertRun(text->sourceRuns[2], 7, 12, 6, 11);
+    assertTextRunsCoverContent(root);
+  }
+
+  {
+    const auto root = parser.parse("😀 same 😀", flags);
+    const auto text = first(root, NodeType::Text);
+    assert(text && text->content == "😀 same 😀");
+    assert(text->sourceRuns.size() == 1);
+    assertRun(text->sourceRuns[0], 0, 10, 0, 10);
+    assertTextRunsCoverContent(root);
+  }
+
+  {
+    const auto root = parser.parse("first\r\nsecond", flags);
+    const auto breaks = collect(root, NodeType::SoftBreak);
+    assert(breaks.size() == 1);
+    assert(breaks[0]->content.empty() && breaks[0]->sourceRuns.size() == 1);
+    assertRun(breaks[0]->sourceRuns[0], 5, 7, 0, 1);
+    assertTextRunsCoverContent(root);
+  }
+
+  {
+    const std::string source = "```\r\n  α😀\r\n```\r\n";
+    const auto root = parser.parse(source, flags);
+    const auto text = first(root, NodeType::Text);
+    assert(text && text->content == "  α😀\n");
+    assert(text->sourceRuns.size() == 2);
+    assertRun(text->sourceRuns[0], 5, 10, 0, 5);
+    assertRun(text->sourceRuns[1], 10, 12, 5, 6);
+    assertTextRunsCoverContent(root);
+  }
+
+  {
+    const std::string source = "> repeated\r\n> repeated\r\n\r\n| repeated | repeated |\r\n| --- | --- |\r\n";
+    const auto root = parser.parse(source, flags, true);
+    const auto texts = collect(root, NodeType::Text);
+    bool foundFirst = false;
+    bool foundSecond = false;
+    bool foundTableFirst = false;
+    bool foundTableSecond = false;
+    for (const auto &text : texts) {
+      if (text->content == "repeated") {
+        foundFirst |= text->sourceRuns.size() == 1 && text->sourceRuns[0].sourceStart == 2;
+        foundSecond |= text->sourceRuns.size() == 1 && text->sourceRuns[0].sourceStart == 14;
+        foundTableFirst |= text->sourceRuns.size() == 1 && text->sourceRuns[0].sourceStart == 28;
+        foundTableSecond |= text->sourceRuns.size() == 1 && text->sourceRuns[0].sourceStart == 39;
+      }
+    }
+    assert(foundFirst && foundSecond && foundTableFirst && foundTableSecond);
+    assertTextRunsCoverContent(root);
+  }
+
+  {
+    const auto root = parser.parse("> outer\n> > inner", flags);
+    const auto texts = collect(root, NodeType::Text);
+    bool foundInner = false;
+    for (const auto &text : texts)
+      foundInner |= text->content == "inner" && text->sourceRuns.size() == 1 && text->sourceRuns[0].sourceStart == 12;
+    assert(foundInner);
+    assertTextRunsCoverContent(root);
+  }
+
+  {
+    const std::string source = "```\n\tfoo\n```\n";
+    const auto root = parser.parse(source, flags);
+    const auto text = first(root, NodeType::Text);
+    assert(text && text->content == "    foo\n");
+    assert(text->sourceRuns.size() == 2);
+    assertRun(text->sourceRuns[0], 4, 5, 0, 4);
+    assertRun(text->sourceRuns[1], 5, 9, 4, 8);
+    assertTextRunsCoverContent(root);
+  }
+
+  {
+    const auto root = parser.parse("```\nx", flags);
+    const auto text = first(root, NodeType::Text);
+    assert(text && text->content == "x\n");
+    assert(text->sourceRuns.size() == 2);
+    assertRun(text->sourceRuns[0], 4, 5, 0, 1);
+    assertRun(text->sourceRuns[1], -1, -1, 1, 2);
+    assertTextRunsCoverContent(root);
+  }
+
+  {
+    const auto root = parser.parse("before dup after dup", flags);
+    Markdown::TextLinkMatchers matchers;
+    matchers.text = [](const std::vector<std::string_view> &runs) {
+      assert(runs.size() == 1 && runs[0] == "before dup after dup");
+      return std::vector<std::vector<Markdown::TextRange>>{{{7, 10}, {17, 20}}};
+    };
+    Markdown::recognizeTextLinks(*root, matchers);
+    const auto links = collect(root, NodeType::Link);
+    assert(links.size() == 2);
+    for (const auto &link : links) {
+      assert(link->sourceRuns.empty());
+      assert(link->children.size() == 1 && link->children[0]->content == "dup");
+      assert(link->children[0]->sourceRuns.size() == 1);
+    }
+    assertRun(links[0]->children[0]->sourceRuns[0], 7, 10, 0, 3);
+    assertRun(links[1]->children[0]->sourceRuns[0], 17, 20, 0, 3);
+    assertTextRunsCoverContent(root);
+  }
+
+  {
+    const auto root = parser.parse("x &amp; y", flags);
+    Markdown::TextLinkMatchers matchers;
+    matchers.text = [](const std::vector<std::string_view> &runs) {
+      assert(runs.size() == 1 && runs[0] == "x & y");
+      return std::vector<std::vector<Markdown::TextRange>>{{{2, 3}}};
+    };
+    Markdown::recognizeTextLinks(*root, matchers);
+    const auto links = collect(root, NodeType::Link);
+    assert(links.size() == 1 && links[0]->children[0]->content == "&");
+    assertRun(links[0]->children[0]->sourceRuns[0], 2, 7, 0, 1);
+    assertTextRunsCoverContent(root);
+  }
+
+  {
+    const auto root = parser.parse("&#128512; and &#128512;", flags);
+    const auto text = first(root, NodeType::Text);
+    assert(text && text->content == "😀 and 😀");
+    assert(text->sourceRuns.size() == 3);
+    assertRun(text->sourceRuns[0], 0, 9, 0, 2);
+    assertRun(text->sourceRuns[1], 9, 14, 2, 7);
+    assertRun(text->sourceRuns[2], 14, 23, 7, 9);
+    assertTextRunsCoverContent(root);
+
+    Markdown::TextLinkMatchers matchers;
+    matchers.text = [](const std::vector<std::string_view> &runs) {
+      assert(runs.size() == 1 && runs[0] == "😀 and 😀");
+      return std::vector<std::vector<Markdown::TextRange>>{{{0, 2}, {7, 9}}};
+    };
+    Markdown::recognizeTextLinks(*root, matchers);
+    const auto links = collect(root, NodeType::Link);
+    assert(links.size() == 2);
+    assertRun(links[0]->children[0]->sourceRuns[0], 0, 9, 0, 2);
+    assertRun(links[1]->children[0]->sourceRuns[0], 14, 23, 0, 2);
+    assertTextRunsCoverContent(root);
+  }
+
+  {
+    const auto root = parser.parse("&NotEqualTilde;", flags);
+    const auto text = first(root, NodeType::Text);
+    assert(text && text->content == "≂̸");
+    assert(text->sourceRuns.size() == 1);
+    assertRun(text->sourceRuns[0], 0, 15, 0, 2);
+
+    Markdown::TextLinkMatchers matchers;
+    matchers.text = [](const std::vector<std::string_view> &runs) {
+      assert(runs.size() == 1 && runs[0] == "≂̸");
+      return std::vector<std::vector<Markdown::TextRange>>{{{0, 1}}};
+    };
+    Markdown::recognizeTextLinks(*root, matchers);
+    assert(collect(root, NodeType::Link).empty());
+    assert(first(root, NodeType::Text) == text);
+    assertTextRunsCoverContent(root);
+  }
+
+  {
+    constexpr size_t occurrenceCount = 10000;
+    std::string source;
+    source.reserve(occurrenceCount * 10 + 1);
+    for (size_t i = 0; i < occurrenceCount; ++i)
+      source += "dup &amp; ";
+    source += 'z';
+    assert(source.size() == 100001);
+
+    const auto root = parser.parse(source, flags);
+    const auto text = first(root, NodeType::Text);
+    assert(text && text->sourceRuns.size() >= occurrenceCount * 2);
+
+    Markdown::TextLinkMatchers matchers;
+    matchers.text = [occurrenceCount](const std::vector<std::string_view> &runs) {
+      assert(runs.size() == 1);
+      std::vector<Markdown::TextRange> matches;
+      size_t offset = 0;
+      while ((offset = runs[0].find("dup", offset)) != std::string_view::npos) {
+        matches.push_back({offset, offset + 3});
+        offset += 3;
+      }
+      assert(matches.size() == occurrenceCount);
+      std::vector<std::vector<Markdown::TextRange>> allMatches;
+      allMatches.push_back(std::move(matches));
+      return allMatches;
+    };
+    Markdown::recognizeTextLinks(*root, matchers);
+
+    const auto links = collect(root, NodeType::Link);
+    assert(links.size() == occurrenceCount);
+    for (size_t i = 0; i < links.size(); ++i) {
+      assert(links[i]->children.size() == 1 && links[i]->children[0]->content == "dup");
+      assert(links[i]->children[0]->sourceRuns.size() == 1);
+      assertRun(links[i]->children[0]->sourceRuns[0], static_cast<int>(i * 10), static_cast<int>(i * 10 + 3), 0, 3);
+    }
+    assertTextRunsCoverContent(root);
+  }
+
+  {
+    const auto root = parser.parse(std::string(10000, 'a'), flags);
+    const auto text = first(root, NodeType::Text);
+    assert(text && text->sourceRuns.size() == 1);
+    assertRun(text->sourceRuns[0], 0, 10000, 0, 10000);
+    assertTextRunsCoverContent(root);
+  }
+}
