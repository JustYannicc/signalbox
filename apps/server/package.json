{
  "name": "t3",
  "version": "0.0.45",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JustYannicc/signalbox",
    "directory": "apps/server"
  },
  "bin": {
    "signalbox": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch src/bin.ts",
    "runner": "node src/signalbox/runner/main.ts",
    "runner:bundle": "vp pack src/signalbox/runner/main.ts -d dist/runner",
    "build:bundle": "vp pack",
    "build:exe": "node scripts/cli.ts build-exe",
    "start": "node dist/bin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "record:codex-replay": "bun scripts/record-codex-app-server-replay-fixture.ts",
    "record:claude-replay": "bun scripts/record-claude-agent-sdk-replay-fixture.ts",
    "record:cursor-replay": "node --env-file-if-exists=../../.env --experimental-strip-types scripts/record-cursor-agent-sdk-replay-fixture.ts",
    "record:pi-replay": "node scripts/record-pi-rpc-replay-fixture.ts",
    "record:grok-replay": "node scripts/record-grok-acp-replay-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.276",
    "@cursor/sdk": "1.0.35",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@ff-labs/fff-node": "0.9.4",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@napi-rs/keyring": "^1.3.0",
    "@noble/hashes": "catalog:",
    "@opencode-ai/sdk": "^1.3.15",
    "@opencode/client": "2.0.23",
    "@opencode/protocol": "2.0.23",
    "@opencode/schema": "2.0.23",
    "diff": "8.0.3",
    "effect": "catalog:",
    "evlog": "2.30.0",
    "jose": "catalog:",
    "node-pty": "^1.2.0-beta.15",
    "oxc-parser": "0.148.0",
    "oxc-transform": "0.148.0",
    "playwright-core": "1.60.0",
    "proper-lockfile": "4.1.2",
    "quickjs-emscripten-core": "0.32.0",
    "stream-chain": "^4.2.5",
    "stream-json": "3.6.0",
    "yaml": "catalog:",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@signalbox/account": "workspace:*",
    "@signalbox/runner-protocol": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/ssh": "workspace:*",
    "@t3tools/tailscale": "workspace:*",
    "@t3tools/web": "workspace:*",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "@types/yauzl": "^3.4.0",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
