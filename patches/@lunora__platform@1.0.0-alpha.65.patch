+  /** Run the job at this absolute timestamp (ms since epoch). Overrides `delayMs`. */
+  at?: number | Date;
+  /** Run the job no sooner than this delay (ms) from now. */
+  delayMs?: number;
+  /** Per-job retry policy. Falls back to the host's defaults when omitted. */
+  retry?: {
