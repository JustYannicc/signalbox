+    backoffMultiplier?: number;
+    /** Retry without an attempt limit, overriding `maxAttempts`; unsupported hosts must reject this option. */
+    forever?: boolean;
+    /** Initial backoff delay (ms). */
+    initialDelayMs?: number;
+    /** Maximum number of delivery attempts. */
+    maxAttempts?: number;
+    /** Maximum backoff delay (ms). */
+    maxDelayMs?: number;
+  };
