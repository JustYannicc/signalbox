{
  "reference": "openai/codex@092d3acd6bec3e3a14bdc7e7a2810ab628ab759d; nucleo synchronous Matcher and ignore serial WalkBuilder",
  "rules": [
    {
      "rule": "file-search-wasi-module-declaration",
      "path": "codex-rs/file-search/src/lib.rs",
      "before": ["mod snapshot;"],
      "after": ["mod snapshot;", "#[cfg(target_os = \"wasi\")]", "mod wasi;"]
    },
    {
      "rule": "file-search-wasi-update",
      "path": "codex-rs/file-search/src/lib.rs",
      "before": [
        "    pub fn update_query(&self, pattern_text: &str) {",
        "        let _ = self",
        "            .inner",
        "            .work_tx",
        "            .send(WorkSignal::QueryUpdated(pattern_text.to_string()));",
        "    }"
      ],
      "after": [
        "    pub fn update_query(&self, pattern_text: &str) {",
        "        #[cfg(target_os = \"wasi\")]",
        "        {",
        "            let snapshot = wasi::search(&self.inner, pattern_text);",
        "            self.inner.reporter.on_update(&snapshot);",
        "            self.inner.reporter.on_complete();",
        "        }",
        "        #[cfg(not(target_os = \"wasi\"))]",
        "        {",
        "            let _ = self.inner.work_tx.send(WorkSignal::QueryUpdated(pattern_text.to_string()));",
        "        }",
        "    }"
      ]
    },
    {
      "rule": "file-search-wasi-session",
      "path": "codex-rs/file-search/src/lib.rs",
      "before": [
        "pub fn create_session(",
        "    search_directories: Vec<PathBuf>,",
        "    options: FileSearchOptions,",
        "    reporter: Arc<dyn SessionReporter>,",
        "    cancel_flag: Option<Arc<AtomicBool>>,",
        ") -> anyhow::Result<FileSearchSession> {",
        "    let FileSearchOptions {",
        "        limit,",
        "        exclude,",
        "        threads,",
        "        compute_indices,",
        "        respect_gitignore,",
        "    } = options;",
        "",
        "    let Some(primary_search_directory) = search_directories.first() else {",
        "        anyhow::bail!(\"at least one search directory is required\");",
        "    };",
        "    let override_matcher = build_override_matcher(primary_search_directory, &exclude)?;",
        "    let (work_tx, work_rx) = unbounded();",
        "",
        "    let notify_tx = work_tx.clone();",
        "    let notify = Arc::new(move || {",
        "        let _ = notify_tx.send(WorkSignal::NucleoNotify);",
        "    });",
        "    let nucleo = Nucleo::new(",
        "        Config::DEFAULT.match_paths(),",
        "        notify,",
        "        Some(threads.get()),",
        "        1,",
        "    );",
        "    let injector = nucleo.injector();",
        "",
        "    let cancelled = cancel_flag.unwrap_or_else(|| Arc::new(AtomicBool::new(false)));",
        "",
        "    let inner = Arc::new(SessionInner {",
        "        search_directories,",
        "        limit: limit.get(),",
        "        threads: threads.get(),",
        "        compute_indices,",
        "        respect_gitignore,",
        "        cancelled,",
        "        shutdown: Arc::new(AtomicBool::new(false)),",
        "        reporter,",
        "        work_tx,",
        "    });",
        "",
        "    let matcher_inner = inner.clone();",
        "    thread::spawn(move || matcher_worker(matcher_inner, work_rx, nucleo));",
        "",
        "    let walker_inner = inner.clone();",
        "    thread::spawn(move || walker_worker(walker_inner, override_matcher, injector));",
        "",
        "    Ok(FileSearchSession { inner })",
        "}"
      ],
      "after": [
        "pub fn create_session(",
        "    search_directories: Vec<PathBuf>,",
        "    options: FileSearchOptions,",
        "    reporter: Arc<dyn SessionReporter>,",
        "    cancel_flag: Option<Arc<AtomicBool>>,",
        ") -> anyhow::Result<FileSearchSession> {",
        "    let FileSearchOptions {",
        "        limit,",
        "        exclude,",
        "        threads,",
        "        compute_indices,",
        "        respect_gitignore,",
        "    } = options;",
        "",
        "    let Some(primary_search_directory) = search_directories.first() else {",
        "        anyhow::bail!(\"at least one search directory is required\");",
        "    };",
        "    let override_matcher = build_override_matcher(primary_search_directory, &exclude)?;",
        "    let (work_tx, work_rx) = unbounded();",
        "",
        "    let cancelled = cancel_flag.unwrap_or_else(|| Arc::new(AtomicBool::new(false)));",
        "",
        "    let inner = Arc::new(SessionInner {",
        "        search_directories,",
        "        #[cfg(target_os = \"wasi\")]",
        "        override_matcher: override_matcher.clone(),",
        "        limit: limit.get(),",
        "        threads: threads.get(),",
        "        compute_indices,",
        "        respect_gitignore,",
        "        cancelled,",
        "        shutdown: Arc::new(AtomicBool::new(false)),",
        "        reporter,",
        "        work_tx,",
        "    });",
        "",
        "    #[cfg(target_os = \"wasi\")]",
        "    return Ok(FileSearchSession { inner });",
        "",
        "    #[cfg(not(target_os = \"wasi\"))]",
        "    {",
        "        let notify_tx = inner.work_tx.clone();",
        "        let notify = Arc::new(move || {",
        "            let _ = notify_tx.send(WorkSignal::NucleoNotify);",
        "        });",
        "        let nucleo = Nucleo::new(",
        "            Config::DEFAULT.match_paths(),",
        "            notify,",
        "            Some(threads.get()),",
        "            1,",
        "        );",
        "        let injector = nucleo.injector();",
        "    ",
        "        let matcher_inner = inner.clone();",
        "        thread::spawn(move || matcher_worker(matcher_inner, work_rx, nucleo));",
        "    ",
        "        let walker_inner = inner.clone();",
        "        thread::spawn(move || walker_worker(walker_inner, override_matcher, injector));",
        "    ",
        "        Ok(FileSearchSession { inner })",
        "    }",
        "}"
      ]
    },
    {
      "rule": "file-search-wasi-overrides",
      "path": "codex-rs/file-search/src/lib.rs",
      "before": [
        "struct SessionInner {",
        "    search_directories: Vec<PathBuf>,",
        "    limit: usize,",
        "    threads: usize,",
        "    compute_indices: bool,",
        "    respect_gitignore: bool,",
        "    cancelled: Arc<AtomicBool>,",
        "    shutdown: Arc<AtomicBool>,",
        "    reporter: Arc<dyn SessionReporter>,",
        "    work_tx: Sender<WorkSignal>,",
        "}"
      ],
      "after": [
        "struct SessionInner {",
        "    search_directories: Vec<PathBuf>,",
        "    #[cfg(target_os = \"wasi\")]",
        "    override_matcher: Option<ignore::overrides::Override>,",
        "    limit: usize,",
        "    threads: usize,",
        "    compute_indices: bool,",
        "    respect_gitignore: bool,",
        "    cancelled: Arc<AtomicBool>,",
        "    shutdown: Arc<AtomicBool>,",
        "    reporter: Arc<dyn SessionReporter>,",
        "    work_tx: Sender<WorkSignal>,",
        "}"
      ]
    },
    {
      "rule": "file-search-wasi-module",
      "path": "codex-rs/file-search/src/wasi.rs",
      "asset": "file-search-wasi.rs"
    }
  ]
}
