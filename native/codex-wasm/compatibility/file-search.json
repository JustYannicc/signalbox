      "rule": "file-search-wasi-update",
      "path": "codex-rs/file-search/src/lib.rs",
      "before": [
        "    pub fn update_query(&self, pattern_text: &str) {",
        "        let _ = self",
        "            .inner",
        "            .work_tx",
        "            .send(WorkSignal::QueryUpdated(pattern_text.to_string()));",
        "    }"
      ],
      "after": [
        "    pub fn update_query(&self, pattern_text: &str) {",
        "        #[cfg(target_os = \"wasi\")]",
        "        {",
        "            let generation = self.inner.generation.fetch_add(1, Ordering::Relaxed) + 1;",
        "            let inner = self.inner.clone();",
        "            let query = pattern_text.to_string();",
        "            tokio::spawn(async move {",
        "                let snapshot = wasi::search(inner.clone(), query, generation).await;",
        "                if inner.generation.load(Ordering::Relaxed) == generation {",
        "                    inner.reporter.on_update(&snapshot);",
        "                }",
        "                inner.reporter.on_complete();",
        "            });",
        "        }",
        "        #[cfg(not(target_os = \"wasi\"))]",
        "        {",
        "            let _ = self.inner.work_tx.send(WorkSignal::QueryUpdated(pattern_text.to_string()));",
        "        }",
        "    }"
      ]
    },
