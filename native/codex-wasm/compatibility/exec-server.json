    {
      "rule": "sandboxed-open",
      "path": "codex-rs/exec-server/src/sandboxed_file_open.rs",
      "before": [
        "    }",
        "}",
        "",
        "// Unix passes the opened fd over the helper's stdin socket.",
        "#[cfg(unix)]",
        "async fn open_platform("
      ],
      "after": [
        "    }",
        "}",
        "",
        "// agentOS wasm32-wasip1: no helper processes with fd passing; the VM is the sandbox,",
        "// so sandboxed opens are refused and callers fall back to direct filesystem access.",
        "#[cfg(target_os = \"wasi\")]",
        "async fn open_platform(",
        "    _command: SandboxExecRequest,",
        "    _request: Vec<u8>,",
        ") -> Result<tokio::fs::File, JSONRPCErrorError> {",
        "    Err(internal_error(",
        "        \"sandboxed file open is unavailable on wasm32-wasip1\".to_string(),",
        "    ))",
        "}",
        "",
        "// Unix passes the opened fd over the helper's stdin socket.",
        "#[cfg(unix)]",
        "async fn open_platform("
      ]
    }
