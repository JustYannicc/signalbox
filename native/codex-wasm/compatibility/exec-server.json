        "mod wasi;",
        "#[cfg(windows)]",
        "mod windows;",
        "",
        "#[cfg(unix)]",
        "use unix as imp;",
        "#[cfg(target_os = \"wasi\")]",
        "use wasi as imp;",
        "#[cfg(windows)]",
        "use windows as imp;",
