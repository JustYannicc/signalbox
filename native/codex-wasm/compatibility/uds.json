{
  "reference": "DigiBugCat/codex-wasi-agentos@45eca7daf24bbac603689cc3229693310d184e51",
  "rules": [
    {
      "rule": "unsupported-sockets",
      "path": "codex-rs/uds/src/lib.rs",
      "before": ["    }", "}", "", "#[cfg(unix)]", "mod platform {", "    use std::io;"],
      "after": [
        "    }",
        "}",
        "",
        "// agentOS wasm32-wasip1: no Unix domain sockets in WASI preview 1.",
        "#[cfg(target_os = \"wasi\")]",
        "mod platform {",
        "    use std::io;",
        "    use std::io::Result as IoResult;",
        "    use std::path::Path;",
        "    use std::pin::Pin;",
        "    use std::task::Context;",
        "    use std::task::Poll;",
        "",
        "    use tokio::io::AsyncRead;",
        "    use tokio::io::AsyncWrite;",
        "    use tokio::io::ReadBuf;",
        "",
        "    fn unsupported() -> io::Error {",
        "        io::Error::new(io::ErrorKind::Unsupported, \"unix sockets are unavailable on wasm32-wasip1\")",
        "    }",
        "",
        "    pub(super) async fn prepare_private_socket_directory(socket_dir: &Path) -> IoResult<()> {",
        "        tokio::fs::create_dir_all(socket_dir).await",
        "    }",
        "",
        "    pub(super) async fn is_stale_socket_path(socket_path: &Path) -> IoResult<bool> {",
        "        Ok(tokio::fs::try_exists(socket_path).await.unwrap_or(false))",
        "    }",
        "",
        "    pub(super) struct Listener;",
        "",
        "    impl Listener {",
        "        pub(super) async fn accept(&mut self) -> IoResult<Stream> {",
        "            Err(unsupported())",
        "        }",
        "    }",
        "",
        "    pub(super) struct Stream;",
        "",
        "    pub(super) async fn bind_listener(_socket_path: &Path) -> IoResult<Listener> {",
        "        Err(unsupported())",
        "    }",
        "",
        "    pub(super) async fn connect_stream(_socket_path: &Path) -> IoResult<Stream> {",
        "        Err(unsupported())",
        "    }",
        "",
        "    impl AsyncRead for Stream {",
        "        fn poll_read(self: Pin<&mut Self>, _cx: &mut Context<'_>, _buf: &mut ReadBuf<'_>) -> Poll<IoResult<()>> {",
        "            Poll::Ready(Err(unsupported()))",
        "        }",
        "    }",
        "",
        "    impl AsyncWrite for Stream {",
        "        fn poll_write(self: Pin<&mut Self>, _cx: &mut Context<'_>, _buf: &[u8]) -> Poll<IoResult<usize>> {",
        "            Poll::Ready(Err(unsupported()))",
        "        }",
        "        fn poll_flush(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<IoResult<()>> {",
        "            Poll::Ready(Ok(()))",
        "        }",
        "        fn poll_shutdown(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<IoResult<()>> {",
        "            Poll::Ready(Ok(()))",
        "        }",
        "    }",
        "}",
        "",
        "#[cfg(unix)]",
        "mod platform {",
        "    use std::io;"
      ]
    }
  ]
}
