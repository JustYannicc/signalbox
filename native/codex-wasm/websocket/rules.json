{
  "version": "0.162.1",
  "commit": "092d3acd6bec3e3a14bdc7e7a2810ab628ab759d",
  "rules": [
    {
      "rule": "dialer-module",
      "path": "codex-rs/websocket-client/src/lib.rs",
      "before": [
        "mod dialer;"
      ],
      "after": [
        "#[cfg(not(all(target_os = \"wasi\", target_env = \"p1\")))]",
        "mod dialer;",
        "#[cfg(all(target_os = \"wasi\", target_env = \"p1\"))]",
        "#[path = \"signalbox_websocket/mod.rs\"]",
        "mod dialer;"
      ]
    },
    {
      "rule": "native-import-Either",
      "path": "codex-rs/websocket-client/src/lib.rs",
      "before": [
        "use futures::future::Either;"
      ],
      "after": [
        "#[cfg(not(all(target_os = \"wasi\", target_env = \"p1\")))]",
        "use futures::future::Either;"
      ]
    },
    {
      "rule": "native-import-TcpStream",
      "path": "codex-rs/websocket-client/src/lib.rs",
      "before": [
        "use tokio::net::TcpStream;"
      ],
      "after": [
        "#[cfg(not(all(target_os = \"wasi\", target_env = \"p1\")))]",
        "use tokio::net::TcpStream;"
      ]
    },
    {
      "rule": "native-import-MaybeTlsStream",
      "path": "codex-rs/websocket-client/src/lib.rs",
      "before": [
        "use tokio_tungstenite::MaybeTlsStream;"
      ],
      "after": [
        "#[cfg(not(all(target_os = \"wasi\", target_env = \"p1\")))]",
        "use tokio_tungstenite::MaybeTlsStream;"
      ]
    },
    {
      "rule": "native-import-WebSocketStream-TungsteniteStream",
      "path": "codex-rs/websocket-client/src/lib.rs",
      "before": [
        "use tokio_tungstenite::WebSocketStream as TungsteniteStream;"
      ],
      "after": [
        "#[cfg(not(all(target_os = \"wasi\", target_env = \"p1\")))]",
        "use tokio_tungstenite::WebSocketStream as TungsteniteStream;"
      ]
    },
    {
      "rule": "connection-alias",
      "path": "codex-rs/websocket-client/src/lib.rs",
      "before": [
        "pub(crate) type ConnectionInner = Either<",
        "    TungsteniteStream<MaybeTlsStream<TcpStream>>,",
        "    TungsteniteStream<MaybeTlsStream<Box<dyn AsyncIo>>>,",
        ">;"
      ],
      "after": [
        "#[cfg(not(all(target_os = \"wasi\", target_env = \"p1\")))]",
        "pub(crate) type ConnectionInner = Either<",
        "    TungsteniteStream<MaybeTlsStream<TcpStream>>,",
        "    TungsteniteStream<MaybeTlsStream<Box<dyn AsyncIo>>>,",
        ">;",
        "#[cfg(all(target_os = \"wasi\", target_env = \"p1\"))]",
        "pub(crate) type ConnectionInner = dialer::HostConnection;"
      ]
    },
    {
      "rule": "connector-tls-field",
      "path": "codex-rs/websocket-client/src/lib.rs",
      "before": [
        "    tcp_nodelay: TcpNodelay,",
        "}"
      ],
      "after": [
        "    tcp_nodelay: TcpNodelay,",
        "    #[cfg(all(target_os = \"wasi\", target_env = \"p1\"))]",
        "    wasi_custom_tls: bool,",
        "}"
      ]
    },
    {
      "rule": "connector-tls-capture",
      "path": "codex-rs/websocket-client/src/lib.rs",
      "before": [
        "        let tls_config = match tls_mode {"
      ],
      "after": [
        "        #[cfg(all(target_os = \"wasi\", target_env = \"p1\"))]",
        "        let wasi_custom_tls = matches!(&tls_mode, WebSocketTlsMode::Rustls(_));",
        "        let tls_config = match tls_mode {"
      ]
    },
    {
      "rule": "connector-tls-initialize",
      "path": "codex-rs/websocket-client/src/lib.rs",
      "before": [
        "            tcp_nodelay: TcpNodelay::Default,"
      ],
      "after": [
        "            tcp_nodelay: TcpNodelay::Default,",
        "            #[cfg(all(target_os = \"wasi\", target_env = \"p1\"))]",
        "            wasi_custom_tls,"
      ]
    },
    {
      "rule": "connector-tls-reject",
      "path": "codex-rs/websocket-client/src/lib.rs",
      "before": [
        "        let uri = request.uri().clone();"
      ],
      "after": [
        "        #[cfg(all(target_os = \"wasi\", target_env = \"p1\"))]",
        "        if self.wasi_custom_tls {",
        "            return Err(WebSocketError::Io(io::Error::new(",
        "                io::ErrorKind::Unsupported,",
        "                \"WASI host WebSocket cannot represent a caller Rustls configuration\",",
        "            )));",
        "        }",
        "        let uri = request.uri().clone();"
      ]
    }
  ]
}
