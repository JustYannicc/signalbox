+//! Host requirements and parking for the wrapper's single-threaded JSPI runtime.
+
+use std::io;
+use std::time::Duration;
+
+#[link(wasm_import_module = "signalbox_emscripten")]
+unsafe extern "C" {
+    fn runtime_require(capabilities: u32) -> i32;
+    fn reactor_new(handle: *mut u32) -> i32;
+    fn reactor_drop(handle: u32) -> i32;
+    fn reactor_wake(handle: u32) -> i32;
+    fn reactor_poll(handle: u32, fds: *mut u8, count: u32,
+                    timeout_ms: i32, ready: *mut u32) -> i32;
+}
+
+fn checked(errno: i32) -> io::Result<()> {
+    match errno {
+        0 => Ok(()),
+        1.. => Err(io::Error::from_raw_os_error(errno)),
+        _ => Err(io::Error::new(io::ErrorKind::InvalidData, "invalid host reactor errno")),
+    }
+}
+
+pub(crate) fn require_host() -> io::Result<()> {
+    // Required capabilities follow activated Cargo features, not a reduced
+    // probe feature set. The host must reject libc stubs and missing bridges.
+    let required = 1
+        | if cfg!(any(feature = "fs", feature = "io-std")) { 2 } else { 0 }
+        | if cfg!(feature = "net") { 4 } else { 0 }
+        | if cfg!(feature = "process") { 8 } else { 0 }
+        | if cfg!(feature = "signal") { 16 } else { 0 };
+    checked(unsafe { runtime_require(required) })
+}
+
+#[derive(Debug)]
+pub(crate) struct Parker(u32);
+
+impl Parker {
+    pub(crate) fn new() -> Self {
+        let mut handle = 0;
+        checked(unsafe { reactor_new(&mut handle) }).expect("create Emscripten host parker");
+        Self(handle)
+    }
+
+    pub(crate) fn park(&self, timeout: Option<Duration>) {
+        let timeout_ms = timeout.map(|duration| {
+            let millis = duration.as_millis() + u128::from(duration.subsec_nanos() % 1_000_000 != 0);
+            millis.min(i32::MAX as u128) as i32
+        }).unwrap_or(-1);
+        let mut ready = 0;
+        checked(unsafe { reactor_poll(self.0, std::ptr::null_mut(), 0, timeout_ms, &mut ready) })
+            .expect("park Emscripten host runtime");
+        assert_eq!(ready, 0, "host parker returned fd events without fds");
+    }
+
+    pub(crate) fn unpark(&self) {
+        checked(unsafe { reactor_wake(self.0) }).expect("wake Emscripten host runtime");
+    }
+}
+
+impl Drop for Parker {
+    fn drop(&mut self) {
+        let _ = unsafe { reactor_drop(self.0) };
+    }
+}
