+#[cfg(target_os = "emscripten")]
+impl Inner {
+    fn park(&self) {
+        self.0.park(None);
+    }
+
+    fn park_timeout(&self, duration: Duration) {
+        self.0.park(Some(duration));
+    }
+
+    fn unpark(&self) {
+        self.0.unpark();
+    }
+
+    fn shutdown(&self) {
+        self.0.unpark();
