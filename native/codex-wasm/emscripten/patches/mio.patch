+//! Single-threaded JSPI reactor. The host owns waiting and the wake latch.
+
+use std::io;
+use std::os::fd::RawFd;
+use std::sync::atomic::{AtomicBool, Ordering::Relaxed};
+
+#[link(wasm_import_module = "signalbox_emscripten")]
+unsafe extern "C" {
+    fn reactor_new(handle: *mut u32) -> i32;
+    fn reactor_drop(handle: u32) -> i32;
+    fn reactor_wake(handle: u32) -> i32;
+    fn reactor_poll(handle: u32, fds: *mut libc::pollfd, count: u32,
+                    timeout_ms: i32, ready: *mut u32) -> i32;
+}
+
+fn checked(errno: i32) -> io::Result<()> {
+    if errno == 0 {
+        Ok(())
+    } else if errno > 0 {
+        Err(io::Error::from_raw_os_error(errno))
+    } else {
+        Err(io::Error::new(io::ErrorKind::InvalidData, "invalid host reactor errno"))
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct Waker {
+    handle: u32,
+    woken: AtomicBool,
+}
+
+impl Waker {
+    pub(crate) fn new_unregistered() -> io::Result<Self> {
+        let mut handle = 0;
+        checked(unsafe { reactor_new(&mut handle) })?;
+        Ok(Self { handle, woken: AtomicBool::new(false) })
+    }
+
+    pub(crate) fn wake(&self) -> io::Result<()> {
+        checked(unsafe { reactor_wake(self.handle) })?;
+        self.woken.store(true, Relaxed);
+        Ok(())
+    }
+
+    pub(crate) fn fd(&self) -> Option<RawFd> {
+        None
+    }
+
+    pub(crate) fn woken(&self) -> bool {
+        self.woken.load(Relaxed)
+    }
+
+    pub(crate) fn ack_and_reset(&self) {
+        self.woken.store(false, Relaxed);
+    }
+
+    // The caller keeps the pollfd array alive until the suspending import returns.
+    pub(crate) unsafe fn poll(&self, fds: *mut libc::pollfd, count: usize,
+                              timeout_ms: i32) -> io::Result<i32> {
+        let count = u32::try_from(count)
+            .map_err(|_| io::Error::new(io::ErrorKind::InvalidInput, "too many host poll fds"))?;
+        let mut ready = 0;
+        checked(unsafe { reactor_poll(self.handle, fds, count, timeout_ms, &mut ready) })?;
+        if ready > count {
+            return Err(io::Error::new(io::ErrorKind::InvalidData, "invalid host reactor event count"));
+        }
+        i32::try_from(ready)
+            .map_err(|_| io::Error::new(io::ErrorKind::InvalidData, "host reactor event count overflow"))
+    }
+}
+
+impl Drop for Waker {
+    fn drop(&mut self) {
+        // Drop cannot report an error; host handles must be released even after poll errors.
+        let _ = unsafe { reactor_drop(self.handle) };
+    }
+}
