-            cstr.as_ptr(),
-            mode.bits(),
-            flags.bits(),
-        )
+        #[cfg(target_os = "emscripten")]
+        {
+            emscripten_compat::faccessat(
+                at_rawfd(dirfd),
+                cstr.as_ptr(),
+                mode.bits(),
+                flags.bits(),
+            )
+        }
+        #[cfg(not(target_os = "emscripten"))]
+        {
+            libc::faccessat(
+                at_rawfd(dirfd),
+                cstr.as_ptr(),
+                mode.bits(),
+                flags.bits(),
+            )
+        }
     })?;
     Errno::result(res).map(drop)
