+use super::{check_errors, io_err, is_timeout_event, timeout_subscription, Events};
+use std::io;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+#[cfg(any(feature = "net", feature = "os-ext"))]
+use crate::{Interest, Token};
+
+struct Subscription {
+    wire: wasi::Subscription,
+    armed: bool,
+}
+
+pub(crate) struct Selector {
+    #[cfg(all(debug_assertions, feature = "net"))]
+    id: usize,
+    subscriptions: Arc<Mutex<Vec<Subscription>>>,
+}
+
+impl Selector {
+    pub(crate) fn new() -> io::Result<Self> {
+        Ok(Self {
+            #[cfg(all(debug_assertions, feature = "net"))]
+            id: super::NEXT_ID.fetch_add(1, super::Ordering::Relaxed),
+            subscriptions: Arc::new(Mutex::new(Vec::new())),
+        })
+    }
+
+    #[cfg(all(debug_assertions, feature = "net"))]
+    pub(crate) fn id(&self) -> usize { self.id }
+
+    pub(crate) fn select(&self, events: &mut Events, timeout: Option<Duration>) -> io::Result<()> {
+        events.clear();
+        let mut registered = self.subscriptions.lock().unwrap();
+        // Poll-local indices identify the exact fd and direction even if tokens repeat.
+        let mut active = Vec::new();
+        for (index, subscription) in registered.iter().enumerate() {
+            if subscription.armed {
+                let mut wire = subscription.wire;
+                wire.userdata = index as wasi::Userdata;
+                active.push(wire);
+            }
+        }
+        if let Some(timeout) = timeout { active.push(timeout_subscription(timeout)); }
+        if active.is_empty() {
+            return Err(io::Error::new(io::ErrorKind::Unsupported,
+                "WASI cannot park without an armed descriptor or clock"));
+        }
+        events.reserve(active.len());
+        let count = unsafe { wasi::poll_oneoff(active.as_ptr(), events.as_mut_ptr(), active.len()) }
+            .map_err(io_err)?;
+        unsafe { events.set_len(count); }
+        events.retain(|event| !is_timeout_event(event));
+        check_errors(events)?;
+        for event in events.iter_mut() {
+            let subscription = registered.get_mut(event.userdata as usize)
+                .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidData, "invalid WASI event index"))?;
+            if event.type_.raw() != subscription.wire.u.tag {
+                return Err(io::Error::new(io::ErrorKind::InvalidData, "invalid WASI event direction"));
+            }
+            subscription.armed = false;
+            event.userdata = subscription.wire.userdata;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn try_clone(&self) -> io::Result<Self> {
+        Ok(Self {
+            #[cfg(all(debug_assertions, feature = "net"))]
+            id: self.id,
+            subscriptions: self.subscriptions.clone(),
+        })
+    }
+
+    cfg_any_os_ext! {
+    pub(crate) fn register(&self, fd: wasi::Fd, token: Token, interests: Interest) -> io::Result<()> {
+        let mut subscriptions = self.subscriptions.lock().unwrap();
+        if subscriptions.iter().any(|entry| descriptor(&entry.wire) == fd) {
+            return Err(io::ErrorKind::AlreadyExists.into());
+        }
+        append(&mut subscriptions, fd, token, interests);
+        Ok(())
+    }
+
+    pub(crate) fn reregister(&self, fd: wasi::Fd, token: Token, interests: Interest) -> io::Result<()> {
+        let mut subscriptions = self.subscriptions.lock().unwrap();
+        if !subscriptions.iter().any(|entry| descriptor(&entry.wire) == fd) {
+            return Err(io::ErrorKind::NotFound.into());
+        }
+        subscriptions.retain(|entry| descriptor(&entry.wire) != fd);
+        append(&mut subscriptions, fd, token, interests);
+        Ok(())
+    }
+
+    pub(crate) fn deregister(&self, fd: wasi::Fd) -> io::Result<()> {
+        let mut subscriptions = self.subscriptions.lock().unwrap();
+        let before = subscriptions.len();
+        subscriptions.retain(|entry| descriptor(&entry.wire) != fd);
+        if before == subscriptions.len() { Err(io::ErrorKind::NotFound.into()) } else { Ok(()) }
+    }
+    }
+}
+
+#[cfg(any(feature = "net", feature = "os-ext"))]
+fn descriptor(subscription: &wasi::Subscription) -> wasi::Fd {
+    // Only fd subscriptions are stored; clocks exist solely in the poll-local vector.
+    unsafe { subscription.u.u.fd_read.file_descriptor }
+}
+
+#[cfg(any(feature = "net", feature = "os-ext"))]
+fn append(entries: &mut Vec<Subscription>, fd: wasi::Fd, token: Token, interests: Interest) {
+    for (enabled, kind) in [(interests.is_readable(), wasi::EVENTTYPE_FD_READ),
+                             (interests.is_writable(), wasi::EVENTTYPE_FD_WRITE)] {
+        if enabled {
+            entries.push(Subscription {
+                wire: wasi::Subscription {
+                    userdata: token.0 as wasi::Userdata,
+                    u: wasi::SubscriptionU { tag: kind.raw(), u: wasi::SubscriptionUU {
+                        fd_read: wasi::SubscriptionFdReadwrite { file_descriptor: fd },
+                    }},
+                },
+                armed: true,
+            });
+        }
+    }
+}
