+use crate::{Interest, Registry, Token};
+use std::io;
+use std::sync::Mutex;
+
+struct Registration {
+    registry: Registry,
+    fd: wasi::Fd,
+    token: Token,
+    interests: Interest,
+}
+
+pub(crate) struct IoSourceState(Mutex<Option<Registration>>);
+
+impl IoSourceState {
+    pub(crate) fn new() -> Self { Self(Mutex::new(None)) }
+
+    pub(crate) fn register(&mut self, registry: &Registry, token: Token,
+                           interests: Interest, fd: wasi::Fd) -> io::Result<()> {
+        let registry = registry.try_clone()?;
+        let state = self.0.get_mut().unwrap();
+        if state.is_some() { return Err(io::ErrorKind::AlreadyExists.into()); }
+        registry.selector().register(fd, token, interests)?;
+        *state = Some(Registration { registry, fd, token, interests });
+        Ok(())
+    }
+
+    pub(crate) fn reregister(&mut self, registry: &Registry, token: Token,
+                             interests: Interest) -> io::Result<()> {
+        let state = self.0.get_mut().unwrap().as_mut().ok_or(io::ErrorKind::NotFound)?;
+        registry.selector().reregister(state.fd, token, interests)?;
+        state.token = token;
+        state.interests = interests;
+        Ok(())
+    }
+
+    pub(crate) fn deregister(&mut self) -> io::Result<()> {
+        let state = self.0.get_mut().unwrap().take().ok_or(io::ErrorKind::NotFound)?;
+        state.registry.selector().deregister(state.fd)
+    }
+
+    pub(crate) fn do_io<T, F, R>(&self, f: F, io: &T) -> io::Result<R>
+    where F: FnOnce(&T) -> io::Result<R> {
+        let result = f(io);
+        if matches!(&result, Err(error) if error.kind() == io::ErrorKind::WouldBlock) {
+            if let Some(state) = self.0.lock().unwrap().as_ref() {
+                state.registry.selector().reregister(state.fd, state.token, state.interests)?;
+            }
+        }
+        result
+    }
+}
