// v1 end to end (#1192): a pool you can invite people to, plus your own accounts connected. Nothing more.
// Everything is yours by default. You can share a pool; your tools always stay yours.
// Only Persons A and B. Each has a personal top level they never see and an own pool that starts empty;
// sharing a pool lends it into the invitee's top level. Local Claude Code and Codex get their models and
// tools from Signalbox through one click. The final interfaces stay underneath (placements, lending,
// resolution); v1 shows that much of them. Not in v1: folders, organizations, domain auto-join, admin roles,
// shared tools, threads, harness runtime, computer, Bases, drive, assistant, automations.
// Modules are black boxes; the Gateway appears only as its two ports. The harness sees a normal provider
// and normal MCP servers.
views {

  style signalbox, platform, modelProviders, services {
    color muted
    opacity 10%
  }

  // ───────────────────────────── 0 · Index ─────────────────────────────

  dynamic view v1_overview_journey {
    #v1
    variant sequence
    title 'Workflows/v1/0 · First day with Signalbox v1'
    description '''
      What does v1 do? Everything is yours by default; you can share a pool, and your tools always stay yours.
      A and B sign in to their own empty pools, A fills A's pool and shares it with B, B picks it for B's
      computer, each connects their own tools, and one click sets up each computer so local Claude Code and
      Codex get models and tools from Signalbox.
    '''

    include personA with { description 'shares a pool' }
    include personB with { description "uses A's shared pool" }
    include laptopCli, signalbox, signalbox.identity, signalbox.models, signalbox.connections, signalbox.gateway

    personA -> signalbox.identity 'Sign in' {
      navigateTo v1_sign_in
      notes """
        - Hosted sign-in, e.g. with Google; an own pool that starts empty
      """
    }
    personB -> signalbox.identity 'Sign in' {
      navigateTo v1_sign_in
      notes """
        - B gets B's own top level and own empty pool too
      """
    }
    personA -> signalbox.models 'Fill my pool' {
      navigateTo v1_pool_one_click
      notes """
        - One click per Claude or ChatGPT subscription; an API key works too
      """
    }
    personA -> signalbox.models 'Share with B' {
      navigateTo v1_invite
      notes """
        - Like sharing a doc: an invite link, a member list, remove
      """
    }
    personB -> signalbox.models "Pick A's pool here" {
      navigateTo v1_invite
      notes """
        - A's shared pool sits next to B's own; one click picks it for this computer
      """
    }
    parallel {
      personA -> signalbox.connections 'My Google · Confluence' {
        navigateTo v1_connections_one_click
        notes """
          - One click each; acts as A and serves only A
        """
      }
      personB -> signalbox.connections 'My Google · Confluence' {
        notes """
          - B's own accounts; sharing the pool never shares tools
        """
      }
    }
    personB -> laptopCli 'Set up this computer' {
      navigateTo v1_set_up_this_computer
      notes """
        - One click: a personal key, then Claude Code and Codex config written
      """
    }
    laptopCli -[model]-> signalbox.gateway 'Model request' {
      navigateTo v1_local_model_request
      notes """
        - Runs on the pool B picked: A's shared pool
      """
    }
    laptopCli -[tool]-> signalbox.gateway 'Tool call' {
      navigateTo v1_local_tool_call
      notes """
        - Only B's own connections
      """
    }
    personA -> signalbox.models 'Usage per member' {
      navigateTo v1_usage
      notes """
        - A sees B's use of A's pool; B sees B's own usage on every pool
      """
    }

    style personA, personB {
      color green
    }
  }

  // ───────────────────────────── 1 · Sign in ─────────────────────────────

  dynamic view v1_sign_in {
    #v1
    variant sequence
    title 'Workflows/v1/1 · Sign in'
    description '''
      What does a person have after signing in for the first time? Hosted sign-in, here with Google. Each
      person gets a personal top level they never see and an own pool on it that starts empty. No
      organization, no picker, nothing to set up.
    '''

    include personA with { description 'first sign-in' }
    include personB with { description 'first sign-in' }
    include signalbox, signalbox.web, signalbox.identity, signalbox.tree, signalbox.models, platform, platform.workos, services, services.google

    personA -> signalbox.web 'Continue with Google'
    signalbox.web -> signalbox.identity 'signIn' {
      navigateTo identity_identity_signin
    }
    signalbox.identity -> platform.workos 'Hosted sign-in' {
      notes """
        - Hosted sign-in; Google is one example provider
      """
    }
    platform.workos -> services.google 'Google sign-in'
    signalbox.identity <- platform.workos 'complete' {
      notes """
        - Returns A; no organization and no account picker
      """
    }
    signalbox.identity -> signalbox.tree 'Personal top level' {
      notes """
        - Made on first sign-in, owned by A, never shown as a thing to manage
      """
    }
    signalbox.identity -> signalbox.models 'Own empty pool' {
      notes """
        - Placed on A's top level and preferred there; accounts come next
      """
    }
    signalbox.web <- signalbox.identity 'Session'
    personA <- signalbox.web 'My pool, empty'
    personB -> signalbox.web 'Continue with Google' {
      notes """
        - Steps 2 to 9 again: B gets B's own top level and own empty pool
      """
    }
    signalbox.identity -> signalbox.models 'Own empty pool'
    personB <- signalbox.web 'My pool, empty'

    style personA, personB {
      color green
    }
  }

  // ───────────────────────────── 2 · Your pool ─────────────────────────────

  dynamic view v1_pool_one_click {
    #v1
    variant sequence
    title 'Workflows/v1/2 · Fill your pool'
    description '''
      How does A put model accounts into A's pool? One click each: a Claude subscription, a ChatGPT
      subscription, or an API key. They sit in Models behind the one model gateway, with the pool backend
      behind it. Nobody ever sees another person's credentials.
    '''

    include personA with { description 'owns this pool' }
    include signalbox, signalbox.web, signalbox.models, modelProviders, modelProviders.anthropic, modelProviders.openai

    personA -> signalbox.web 'Add Claude subscription' {
      navigateTo folders_pools_signin_subscription
      notes """
        - On A's pool, made empty at sign-in
      """
    }
    signalbox.web -> signalbox.models 'connect(my pool)'
    signalbox.models -> modelProviders.anthropic 'Subscription sign-in' {
      notes """
        - One click opens the provider's sign-in; A approves
      """
    }
    personA -> signalbox.web 'Add ChatGPT subscription'
    signalbox.web -> signalbox.models 'connect(my pool)'
    signalbox.models -> modelProviders.openai 'Subscription sign-in' {
      notes """
        - One click; device code
      """
    }
    opt 'an API key instead or too' {
      personA -> signalbox.web 'Paste API key' {
        navigateTo folders_pools_paste_credentials
      }
      signalbox.web -> signalbox.models 'connect(API key)'
    }
    signalbox.models -> signalbox.models 'Seal into the pool backend' {
      notes """
        - Credentials live in the pool host, never on a client
        - Nobody, A included, sees them again; members never see them at all
      """
    }
    personA <- signalbox.web 'Pool ready'

    style personA {
      color green
    }
  }

  // ───────────────────────────── 3 · Share ─────────────────────────────

  dynamic view v1_invite {
    #v1
    variant sequence
    title 'Workflows/v1/3 · Share your pool'
    description '''
      How does A share a pool with B, and how does A stop it? As easily as sharing a doc: an invite by email
      or link, a member list, remove. Underneath, the invite lends the pool into B's top level, so the
      hierarchy resolves it for B. B sees it next to B's own pool and picks one per computer. Sharing a pool
      never shares tools: A's and B's connections stay separate.
    '''

    include personA with { description 'shares a pool' }
    include personB with { description 'invited' }
    include laptopCli, signalbox, signalbox.web, signalbox.models, signalbox.tree, signalbox.gateway.modelGateway

    personA -> signalbox.web 'Share pool' {
      notes """
        - From the pool: copy an invite link, or type B's email
      """
    }
    signalbox.web -> signalbox.models 'Invite link'
    personB -> signalbox.web 'Open link' {
      navigateTo v1_sign_in
      notes """
        - Signs in first if B has no account yet
      """
    }
    signalbox.web -> signalbox.models 'accept'
    signalbox.models -> signalbox.tree "Loan into B's top level" {
      navigateTo state_loan
      notes """
        - A loan, not a copy: the pool stays A's, its credentials stay hidden
        - Only the pool is lent: A's and B's connections stay separate
      """
    }
    personB <- signalbox.web 'Two pools' {
      notes """
        - B's own pool and A's shared pool, side by side
      """
    }
    personB -> signalbox.web 'Use for this computer' {
      notes """
        - One click per computer
      """
    }
    signalbox.web -> signalbox.tree 'Set preferred' {
      notes """
        - The `preferred` pick among the pools at B's top level
      """
    }
    laptopCli -[model]-> signalbox.gateway.modelGateway "B's requests" {
      navigateTo v1_local_model_request
      notes """
        - Now served by A's pool
      """
    }
    personA -> signalbox.web 'Members' {
      navigateTo v1_usage
      notes """
        - A and B, with each one's usage
      """
    }
    opt 'A removes B' {
      personA -> signalbox.web 'Remove B'
      signalbox.web -> signalbox.models 'End loan'
      signalbox.models -> signalbox.tree "Unplace from B's top level"
      laptopCli -[model]-> signalbox.gateway.modelGateway "B's next request"
      signalbox.gateway.modelGateway -> signalbox.tree 'Resolve pool'
      laptopCli <- signalbox.gateway.modelGateway 'Pool removed' {
        notes """
          - Fails clearly, never a silent switch; B picks B's own pool again in one click
          - B's key and B's own connections are untouched
        """
      }
    }

    style personA, personB {
      color green
    }
  }

  // ───────────────────────────── 4 · Usage ─────────────────────────────

  dynamic view v1_usage {
    #v1
    variant sequence
    title 'Workflows/v1/4 · Understand usage'
    description '''
      Who sees which usage? The pool owner sees usage per member, per model and over time. Each member sees
      their own usage on every pool they use. Every model request is metered with its person, pool and model.
    '''

    include personA with { description 'owns the pool' }
    include personB with { description "member of A's pool" }
    include laptopCli, signalbox, signalbox.web, signalbox.gateway.modelGateway, signalbox.models

    laptopCli -[model]-> signalbox.gateway.modelGateway 'Model request' {
      navigateTo v1_local_model_request
    }
    signalbox.gateway.modelGateway -[async]-> signalbox.models 'meter' {
      navigateTo folders_usage_record
      notes """
        - One usage row: person, pool, model, tokens, time; off the request path
      """
    }
    personA -> signalbox.web "My pool's usage"
    signalbox.web -> signalbox.models 'view(pool usage)'
    personA <- signalbox.web 'Per member · model · time' {
      notes """
        - A sees A and B on A's pool, split by model and over time
        - Never B's use of other pools
      """
    }
    personB -> signalbox.web 'My usage'
    signalbox.web -> signalbox.models 'view(my usage)'
    personB <- signalbox.web 'Mine, on every pool' {
      notes """
        - B's own usage on B's pool and on A's shared pool
        - Never other members' usage
      """
    }

    style personA, personB {
      color green
    }
  }

  // ───────────────────────────── 5 · Your own tools ─────────────────────────────

  dynamic view v1_connections_one_click {
    #v1
    variant sequence
    title 'Workflows/v1/5 · Connect your own tool accounts'
    description '''
      How does each person bring their own Google and Confluence? One click each through hosted OAuth, no
      admin. A connection acts as the person who made it, sits on their top level and serves only their
      requests; sharing a pool never shares tools. The tools gateway (Gateway plus Connections) exposes
      them through that person's MCP endpoint, with tool search by default.
    '''

    include personA with { description 'own tools' }
    include personB with { description 'own tools' }
    include signalbox, signalbox.web, signalbox.ingress, signalbox.gateway.toolGateway, signalbox.connections, signalbox.tree, services, services.google, services.atlassian

    personA -> signalbox.web 'Connect my Google'
    signalbox.web -> signalbox.connections 'connect(Google)' {
      notes """
        - Hosted OAuth: the Signalbox-hosted service provides the OAuth app
      """
    }
    signalbox.web -> services.google 'Consent' {
      notes """
        - A's one human click
        - If A's Google Workspace restricts third-party apps, allowing our OAuth
          client is that customer's setting, outside Signalbox
      """
    }
    services.google -> signalbox.ingress 'OAuth callback'
    signalbox.ingress -> signalbox.connections 'complete' {
      navigateTo state_connection
      notes """
        - Tokens sealed in the vault; no client ever holds them
      """
    }
    signalbox.connections -> signalbox.tree "Place at A's top level" {
      notes """
        - Acts as A, serves only A's requests
      """
    }
    personA -> signalbox.web 'Connect my Confluence' {
      notes """
        - Same one click: steps 2 to 6 with Atlassian
      """
    }
    signalbox.web -> services.atlassian 'Consent'
    signalbox.connections -> signalbox.tree "Place at A's top level"
    personB -> signalbox.web 'Connect my Google' {
      notes """
        - B's own account, same steps, placed on B's top level
        - Even while B uses A's pool, A's and B's tools never mix
      """
    }
    signalbox.connections -> signalbox.tree "Place at B's top level"
    personA -> signalbox.gateway.toolGateway 'My MCP endpoint' {
      notes """
        - A's own endpoint, reached with A's key
      """
    }
    signalbox.gateway.toolGateway -> signalbox.tree "Resolve A's top level"
    signalbox.gateway.toolGateway -> signalbox.connections 'toolbox' {
      notes """
        - A's Google and Confluence only; never B's
        - search + execute: tools are found by search, not listed
      """
    }
    personA <- signalbox.gateway.toolGateway 'search · execute'
    opt 'A disconnects' {
      personA -> signalbox.web 'Disconnect Google'
      signalbox.web -> signalbox.connections 'disconnect' {
        notes """
          - The next tool call through it fails clearly
        """
      }
    }

    style personA, personB {
      color green
    }
  }

  // ───────────────────────────── 6 · Set up this computer ─────────────────────────────

  dynamic view v1_set_up_this_computer {
    #v1
    variant sequence
    title 'Workflows/v1/6 · Set up this computer'
    description '''
      What does one click on "Set up this computer" change on B's machine? It mints a personal key and writes
      Claude Code's and Codex's own config so their models and tools go through Signalbox. The desktop app
      writes it, or a served command does in a terminal (#403). Codex runs on the Signalbox key alone, with no
      OpenAI sign-in (#449; #assumption, see its step). Undo removes exactly what was written.
    '''

    include personB with { description 'sets up a computer' }
    include signalbox, signalbox.desktop, signalbox.cli, signalbox.gateway, signalbox.identity, laptopCli

    personB -> signalbox.desktop 'Set up this computer' {
      notes """
        - One click; the web app shows the same button
      """
    }
    signalbox.desktop -> signalbox.gateway 'Mint my key' {
      navigateTo folders_pools_local_key
      notes """
        - Personal: it carries B and B's top level
        - Its requests use the pool B picked for this computer
      """
    }
    signalbox.gateway -> signalbox.identity 'Sign for B'
    signalbox.desktop <- signalbox.gateway 'Personal key'
    alt 'who writes the config' {
      when 'desktop app' {
        signalbox.desktop -> laptopCli 'Write Claude Code' {
          notes """
            - Settings env `ANTHROPIC_BASE_URL` → the Signalbox model gateway
            - The key in Claude Code's own settings, so a Dock-launched app works too
            - A `signalbox` MCP server → B's MCP endpoint
          """
        }
        signalbox.desktop -> laptopCli 'Write Codex' {
          notes """
            - `~/.codex/config.toml`: a `model_providers` entry with `requires_openai_auth = false`,
              the Signalbox endpoint and the key in `http_headers`; `model_provider` selects it
            - Codex runs on the Signalbox key alone, with no OpenAI sign-in
            - `#assumption`: what turning OpenAI auth off disables is being checked separately
            - A `signalbox` MCP server → B's MCP endpoint
          """
        }
      }
      else 'terminal' {
        personB -> signalbox.cli 'Run served command' {
          navigateTo folders_modelgateway_laptop_pool
          notes """
            - The page shows one command for machines without the desktop app
          """
        }
        signalbox.cli -> laptopCli 'Write the same config'
      }
    }
    laptopCli -> laptopCli 'Normal provider · MCP' {
      notes """
        - Each harness sees one more provider and one more MCP server, nothing else
      """
    }
    opt 'undo' {
      signalbox.desktop -> laptopCli 'Remove what was written' {
        notes """
          - Exactly the written entries; B's other settings untouched
        """
      }
    }
    opt 'revoke the key' {
      personB -> signalbox.desktop 'Revoke key'
      signalbox.desktop -> signalbox.gateway 'Revoke'
      laptopCli -> signalbox.gateway 'Next request'
      laptopCli <- signalbox.gateway 'Denied' {
        notes """
          - Fails clearly on the very next model or tool request
        """
      }
    }

    style personB {
      color green
    }
  }

  // ───────────────────────────── 7 · Local model request ─────────────────────────────

  dynamic view v1_local_model_request {
    #v1
    variant sequence
    title 'Workflows/v1/7 · Local model request'
    description '''
      Which pool serves a local request? Each request carries the personal key to the model gateway. Tree
      resolves the pool the person picked for that computer among the pools at their top level: here A's pool,
      lent into B's top level. Models serves it through the pool's accounts and meters the usage.
    '''

    include personB with { description "uses A's shared pool" }
    include laptopCli, signalbox, signalbox.gateway.modelGateway, signalbox.identity, signalbox.tree, signalbox.models, modelProviders, modelProviders.anthropic, modelProviders.openai

    personB -> laptopCli 'Runs Claude Code'
    laptopCli -[model]-> signalbox.gateway.modelGateway 'Messages call + key' {
      notes """
        - `ANTHROPIC_BASE_URL` points here; Claude Code thinks it is a normal provider
      """
    }
    signalbox.gateway.modelGateway -> signalbox.identity 'Verify key' {
      notes """
        - Yields B and B's top level
      """
    }
    signalbox.gateway.modelGateway -> signalbox.tree 'Resolve pool' {
      navigateTo folders_placement_resolve
      notes """
        - Pools at B's top level: B's own and A's loan; the `preferred` pick wins
        - Here that is A's shared pool
      """
    }
    signalbox.gateway.modelGateway -[model]-> signalbox.models 'serve' {
      notes """
        - The pool backend picks one of the pool's accounts
      """
    }
    signalbox.models -[model]-> modelProviders.anthropic 'Messages'
    laptopCli <- signalbox.gateway.modelGateway 'Streamed reply'
    signalbox.gateway.modelGateway -[async]-> signalbox.models 'meter' {
      navigateTo v1_usage
      notes """
        - Usage row for B on A's pool, by model; off the request path
      """
    }
    personB -> laptopCli 'Runs Codex'
    laptopCli -[model]-> signalbox.gateway.modelGateway 'Responses call + key' {
      notes """
        - Same key, same steps 3 to 8
        - Key only: `requires_openai_auth = false`, no OpenAI sign-in (`#assumption`)
      """
    }
    signalbox.gateway.modelGateway -[model]-> signalbox.models 'serve'
    signalbox.models -[model]-> modelProviders.openai 'Responses'
    laptopCli <- signalbox.gateway.modelGateway 'Streamed reply'

    style personB {
      color green
    }
  }

  // ───────────────────────────── 8 · Local tool call ─────────────────────────────

  dynamic view v1_local_tool_call {
    #v1
    variant sequence
    title 'Workflows/v1/8 · Local tool call'
    description '''
      Which tools does a local harness get? Only its own person's connections. B's local Codex calls the
      `signalbox` MCP server, which is the tools gateway (Gateway plus Connections). It finds Confluence by tool
      search, runs it through execute, and the tools gateway fills B's credentials from the vault at egress. B uses
      A's shared pool, but sharing a pool never shares tools: A's connections never resolve for B.
    '''

    include personB with { description "uses A's shared pool" }
    include laptopCli, signalbox, signalbox.gateway.toolGateway, signalbox.tree, signalbox.connections, services, services.atlassian

    personB -> laptopCli 'Ask in Codex'
    laptopCli -[tool]-> signalbox.gateway.toolGateway 'search "confluence"' {
      navigateTo folders_connections_tool_search_call
      notes """
        - The `signalbox` MCP server's search tool, with B's key
      """
    }
    signalbox.gateway.toolGateway -> signalbox.tree "Resolve B's top level" {
      notes """
        - B's own connections only
        - The pool loan from A brings no tools: A's connections never resolve for B
      """
    }
    signalbox.gateway.toolGateway -> signalbox.connections 'toolbox (search)'
    laptopCli <- signalbox.gateway.toolGateway 'Confluence tools'
    laptopCli -[tool]-> signalbox.gateway.toolGateway 'execute'
    signalbox.gateway.toolGateway -[tool]-> signalbox.connections 'call'
    signalbox.connections -> signalbox.connections 'Fill from vault' {
      notes """
        - B's credentials, injected at egress only; never returned to the harness
      """
    }
    signalbox.connections -[tool]-> services.atlassian 'Confluence API'
    laptopCli <- signalbox.gateway.toolGateway 'Result'

    style personB {
      color green
    }
  }
}
