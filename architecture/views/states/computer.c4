// State machine for the boxd VM behind one thread's computer. The walk through it with people and modules is the dynamic view state_computer.
model {
  smVm = state 'VM lifecycle (boxd)' {
    none = state 'No VM' { description 'harness runs in its isolate · no machine' }
    creating = state 'Creating' { description 'forking the warm Base · idempotent by name' }
    configuring = state 'Configuring' { description 'isolated · egress allowlist · auto-delete timer' }
    attached = state 'Attached' { description 'runs commands only' }
    hibernated = state 'Hibernated'
    deleted = state 'Deleted' { description 'only regenerable state lost · next command forks anew' }

    none -[transition]-> creating 'command needs a machine'
    creating -[transition]-> configuring 'fork ready'
    configuring -[transition]-> attached 'ready'
    attached -[transition]-> hibernated '2-min idle'
    hibernated -[transition]-> attached 'next command'
    hibernated -[transition]-> deleted 'thread settled · archived · timer'
    attached -[transition]-> deleted 'orphan reconciled'
  }
}
views {
  view state-vm of smVm {
    title 'States/Computer/State machine'
    description 'When does a thread get a boxd VM and when does it go away? The harness never lives here; a VM exists only while commands run. Start: green. End: gray. Click the frame for the walk with people and modules (state_computer).'
    include *
    include smVm with { navigateTo state_computer }
    style smVm.none { color green }
    style smVm.deleted { color gray }
    autoLayout TopBottom
  }
}
