model {
  extend signalbox {
    computer = module 'Computer' {
      #deep
      icon bootstrap:terminal
      description 'open · exec · files · port · save'
      technology 'one computer per thread; placement hidden'
      metadata {
        interface '5'
        deletion 'placement and path classes leak into Thread, Harness and prompts'
      }

      api = iface 'Computer · interface' {
        description '5 verbs: open · exec · files · port · save'
        technology 'Deletion test: without it, placement and path classes leak into Thread, Harness and prompts'
      }

      backend = part 'Computer seam · 2 adapters' {
        metadata { adapters '2' }
        kernelFs = adapter 'Kernel + escalation' {
          #publishable
          icon tech:cloudflare-workers-icon
          description 'prod'
          technology 'our kernel ABI · inode store on SQLite (#1061) · WASI programs · Node and Bun on workerd'
        }
        localProcess = adapter 'LocalProcess' {
          icon tech:nodejs-icon
          description 'tests · dev'
        }
      }

      machines = part 'Machine seam · 1 adapter' {
        #hypothetical-seam
        description 'VM provider for escalation'
        metadata { adapters '1' }
        boxdMachines = adapter 'boxd' {
          icon bootstrap:pc-display
          technology '@boxd-sh/sdk/web · grpc-web on a Cloudflare HTTPS port (443 · 2053 · 2083 · 2087 · 2096 · 8443; not :9443)'
        }
      }

      liveView = part 'Desktop stream' {
        icon bootstrap:display
        description 'watch · take over'
      }
      escalation = part 'Escalation table' {
        #publishable #decided
        icon bootstrap:arrow-up-right-square
        description 'per program at kernel exec; small isolate set, rest to the VM'
        metadata {
          routing 'chosen per program at kernel exec (EscalationTable, #1071, #1247); the unchanged harness Bash tool has no backend choice and placement is invisible'
          isolate 'kept tight (Yannic, 2026-10-19): file edits, cat, ls, grep/rg and basic plumbing'
          vm 'by design: typecheck, builds, installs, tests, unknown programs, apt, docker, native toolchains; a long-lived process behind port stays on the VM for its lifetime'
          measured 'the isolate set is measured from real sessions (#1250); #1250 also evaluates a pre-routing parser so a whole command goes to the VM when any program in it needs one'
          replay 'replayed on the VM only when the failure proves nothing ran (missing program, or ENOSYS before any side effect); anything else is surfaced, never retried blindly'
          noClasses 'no machine classes and no thread moves'
        }
      }
      pathClasses = part 'Path classes' {
        description 'source · kept-local · regenerable'
        metadata {
          secretViews 'canonical view (placeholders) for every record, revision and git object; raw view in memory only, for live exec and VM materialization (#1242)'
          git 'always in the kernel on the canonical view; never escalated; VMs get .git read-only and it is never pulled back'
          concurrentWrites 'while an escalated exec runs, the last write per path wins, by write time, as on one machine'
          attachedProcess 'a long-lived VM process gets kernel source writes as a debounced delta stream until it exits or the VM hibernates'
        }
      }
      childIsolates = part 'Child Dynamic Workers' {
        #publishable
        icon tech:webassembly
        description 'programs, ≤10 in flight'
        technology 'GNU Bash 5.2.37 (WASI) · coreutils · ripgrep · C and JS Git · Node and Bun shims'
      }
      execDaemon = part 'Exec daemon' {
        icon tech:linux-tux
        description 'on VM: commands only'
        technology 'native Runner (systemd) · node-pty'
      }
      vmLifecycle = part 'VM lifecycle' {
        description 'create · adopt · hibernate · delete'
      }

      backend.kernelFs -> childIsolates 'run program'
      backend.kernelFs -> escalation 'needs a machine?'
      escalation -> vmLifecycle 'escalate argv'
      vmLifecycle -> machines.boxdMachines 'create · fork'
      vmLifecycle -> execDaemon 'bracket: push · run · pull'
      pathClasses -> backend.kernelFs 'sync rules'
    }

    computer.machines.boxdMachines -> platform.boxd 'vm control'
    computer.vmLifecycle -> signalbox.bases.api 'base lease (idempotent on operationId)'
    computer.backend.kernelFs -> signalbox.drive.api 'revisions'
    computer.execDaemon -> signalbox.gateway.api 'egress (EgressProxy)'
    computer.childIsolates -> signalbox.gateway.api 'egress (EgressFilter)'
    computer.childIsolates -> signalbox.actorhost.api 'isolates'

    // Interface → hidden parts (the only way in)
    computer.api -> computer.backend 'open · exec · files · save'
    computer.api -> computer.liveView 'port · watch'
  }
}
